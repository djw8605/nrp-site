---
/**
 * The client index for /documentation/userdocs/ai/llm-managed/client-configs.
 *
 * The page carries one section per coding client, each with its config folded
 * into a <ConfigDrawer>. Closed, the whole page is a screen of headings — which
 * is the point, but it also means the reader has to scroll past seven clients
 * they don't use to reach theirs. This row is the shortcut: every client, one
 * line, in the content column where the right-rail table of contents isn't.
 *
 * Chips inherit `text-muted` and take their boundary from `border-current`
 * rather than a hairline, the same control idiom as EndpointPanel's copy chip
 * and the office-hours join button (DESIGN.md §2, §6): a hairline measures
 * ~1.4:1 here and a control's edge needs 3:1.
 */
interface Client {
  /** Display name, as the section heading spells it. */
  name: string;
  /** Slug of the section's <h2>, which Starlight generates from the heading. */
  anchor: string;
}

interface Props {
  clients: Client[];
}

const { clients } = Astro.props;
---

<nav class="client-picker" aria-label="Jump to a client">
  {
    clients.map((c) => (
      <a class="client-chip" href={`#${c.anchor}`}>
        {c.name}
      </a>
    ))
  }
</nav>

<script>
  /**
   * A chip lands the reader on the heading, but the config beneath it is still
   * folded, so the jump would cost a second click on the thing they came for.
   * Open the section's first drawer on arrival — from a chip, from a pasted
   * link with a fragment, or from the browser's back button.
   *
   * Progressive enhancement: without this, every drawer still opens on click.
   */
  function openDrawerFor(hash: string) {
    if (!hash || hash.length < 2) return;
    let el: Element | null = null;
    try {
      el = document.getElementById(decodeURIComponent(hash.slice(1)));
    } catch {
      return;
    }
    if (!el) return;

    // Walk forward through the section's siblings, stopping at the next
    // heading of the same or higher rank, and open the first drawer found.
    const startRank = Number(el.tagName.match(/^H([1-6])$/)?.[1] ?? 0);
    for (let sib = el.nextElementSibling; sib; sib = sib.nextElementSibling) {
      const rank = Number(sib.tagName.match(/^H([1-6])$/)?.[1] ?? 0);
      if (rank && startRank && rank <= startRank) return;
      const drawer = sib.matches('details.config-drawer') ? sib : sib.querySelector('details.config-drawer');
      if (drawer) {
        (drawer as HTMLDetailsElement).open = true;
        return;
      }
    }
  }

  openDrawerFor(location.hash);
  addEventListener('hashchange', () => openDrawerFor(location.hash));
</script>

<style>
  .client-picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 1.5rem 2rem;
  }

  .client-chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid currentcolor;
    border-radius: 0.375rem;
    padding: 0.3125rem 0.6875rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1.3;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition:
      color 150ms ease-out,
      background-color 150ms ease-out;
  }

  /* Starlight paints every link in markdown content with the accent colour, at
     a specificity a scoped class cannot reach. Eight accent chips in a row read
     as a warning strip, not an index — the chip idiom is quiet by default and
     accents on hover (DESIGN.md §6) — so state both colours at its weight. */
  :global(.sl-markdown-content) .client-chip {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }

  :global(.sl-markdown-content) .client-chip:hover,
  :global(.sl-markdown-content) .client-chip:focus-visible {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-gray-6);
  }

  /* A 30px chip is a thumb-sized miss on a phone. The row already wraps to
     three lines there, so the height costs nothing the layout was using. */
  @media (max-width: 40rem) {
    .client-chip {
      padding: 0.625rem 0.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .client-chip {
      transition: none;
    }
  }
</style>
