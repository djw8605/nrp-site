---
import { APP_BLOG } from 'astrowind:config';
import type { Post } from '~/types';

import Image from '~/components/common/Image.astro';

import { findImage } from '~/utils/images';
import { getPermalink } from '~/utils/permalinks';

import defaultImage from '~/assets/images/NRP_globe.jpg';

export interface Props {
  post: Post;
}

const { post } = Astro.props;
const image = (await findImage(post.image)) || defaultImage;

const link = APP_BLOG?.post?.isEnabled ? getPermalink(post.permalink, 'post') : '';
---

<article
  class="mb-6 transition"
>
  <div class="relative mb-5 overflow-hidden rounded-lg border border-hairline bg-surface-2 md:h-64">
    {
      image &&
        (link ? (
          <a href={link}>
            <Image
              src={image}
              class="w-full md:h-full object-cover"
              widths={[400, 900]}
              width={400}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post.title}
              aspectRatio="16:9"
              layout="cover"
              loading="lazy"
              decoding="async"
            />
          </a>
        ) : (
          <Image
            src={image}
            class="w-full md:h-full object-cover"
            widths={[400, 900]}
            width={400}
            sizes="(max-width: 900px) 400px, 900px"
            alt={post.title}
            aspectRatio="16:9"
            layout="cover"
            loading="lazy"
            decoding="async"
          />
        ))
    }
  </div>

  {/* mt-4/mb-2, not mb-2 alone: a heading gets more room above it than below,
      so it binds to the text it introduces rather than floating between the
      image and the excerpt equally. */}
  <h3 class="mb-2 mt-4 font-display text-h3 font-semibold leading-tight text-heading">
    {
      link ? (
        <a class="inline-block transition-colors hover:text-link" href={link}>
          {post.title}
        </a>
      ) : (
        post.title
      )
    }
  </h3>

  <p class="text-muted">{post.excerpt}</p>
</article>
