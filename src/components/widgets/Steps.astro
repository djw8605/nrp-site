---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Timeline from '~/components/ui/Timeline.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';
import type { Steps as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  titleAs,
  items = [],
  callToAction,
  image = await Astro.slots.render('image'),
  isReversed = false,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  width,
  rhythm,
  surface,
} = Astro.props;
---

{
  /* max-w-5xl used to be hardcoded here, making this the one 1024px section on a
    page of 1152px ones. DESIGN.md section 4. */
}
<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={classes?.container ?? ''}
  bg={bg}
  width={width}
  rhythm={rhythm}
  surface={surface}
>
  <div class:list={['flex flex-col gap-8 md:gap-12', { 'md:flex-row-reverse': isReversed }, { 'md:flex-row': image }]}>
    <div class:list={['md:py-4 md:self-center', { 'md:basis-1/2': image }, { 'w-full': !image }]}>
      <Headline
        titleAs={titleAs}
        title={title}
        subtitle={subtitle}
        tagline={tagline}
        classes={{
          container: 'text-left rtl:text-right',
          title: 'text-h2',
          ...((classes?.headline as object) ?? {}),
        }}
      />
      <Timeline items={items} classes={classes?.items as Record<string, never>} />
      {
        /* Types.Steps declares callToAction; the widget used to drop it. */
        callToAction && typeof callToAction !== 'string' && callToAction.href && (
          <div class="mt-8">
            <Button variant="link" {...callToAction} />
          </div>
        )
      }
    </div>
    {
      image && (
        <div class="relative md:basis-1/2">
          {typeof image === 'string' ? (
            <Fragment set:html={image} />
          ) : (
            <Image
              class="inset-0 w-full rounded-lg border border-hairline bg-surface-2 object-cover object-top md:absolute md:h-full"
              widths={[400, 768]}
              sizes="(max-width: 768px) 100vw, 432px"
              width={432}
              height={768}
              layout="cover"
              src={image?.src}
              alt={image?.alt || ''}
            />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>
