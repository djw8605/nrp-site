---
// src/components/NextOfficeHours.astro
// Bi-weekly office hours on Tuesdays at 10 AM PT
// Reference date: March 17, 2026 (a bi-weekly office hours Tuesday)

const uniqueId = `next-office-hours-${crypto.randomUUID().slice(0, 8)}`;
---

<span id={uniqueId}>Loading next office hours...</span>

<script define:vars={{ elementId: uniqueId }}>
  function calculateAndDisplayNextOfficeHours(targetElementId) {
    const targetElement = document.getElementById(targetElementId);
    if (!targetElement) return;

    const pacificTimezone = 'America/Los_Angeles';
    const now = new Date();

    // Reference date: March 17, 2026 at 10 AM PT is a known bi-weekly office hours date
    const referenceDate = new Date('2026-03-17T17:00:00Z');
    const BIWEEKLY_MS = 14 * 24 * 60 * 60 * 1000;

    // Calculate how many bi-weekly periods have passed since reference
    const msSinceReference = now.getTime() - referenceDate.getTime();
    const periodsSinceReference = Math.floor(msSinceReference / BIWEEKLY_MS);

    // Start checking from the most recent bi-weekly Tuesday
    let candidateDate = new Date(referenceDate.getTime() + periodsSinceReference * BIWEEKLY_MS);

    // If this candidate is in the past, move to the next one
    if (candidateDate.getTime() < now.getTime()) {
      candidateDate = new Date(candidateDate.getTime() + BIWEEKLY_MS);
    }

    const displayFormatter = new Intl.DateTimeFormat('en-US', {
      weekday: 'short',
      month: 'short',
      day: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
      timeZone: pacificTimezone
    });

    const formattedDate = displayFormatter.format(candidateDate) + ' PT';

    targetElement.textContent = formattedDate;

    // Also update announcement bar if it exists
    const announcementEl = document.querySelector('[data-announcement-id="office-hours"] span.text-white\\/45');
    if (announcementEl) {
      announcementEl.textContent = 'Next: ' + formattedDate;
    }
  }

  calculateAndDisplayNextOfficeHours(elementId);

  document.addEventListener('astro:page-load', () => {
    calculateAndDisplayNextOfficeHours(elementId);
  });
</script>
