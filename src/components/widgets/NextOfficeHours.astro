---
// src/components/NextOfficeHours.astro

const uniqueId = `next-office-hours-${crypto.randomUUID().slice(0, 8)}`;
---

<span id={uniqueId}>Loading next office hours...</span>

<script define:vars={{ elementId: uniqueId }}>
  function calculateAndDisplayNextOfficeHours(targetElementId) {
    const targetElement = document.getElementById(targetElementId);
    if (!targetElement) return;

    const pacificTimezone = 'America/Los_Angeles';

    // Get current time IN PACIFIC timezone, not browser local time
    const nowInPacific = new Date(new Date().toLocaleString('en-US', { timeZone: pacificTimezone }));

    // Get day of week in Pacific (0 = Sunday)
    const dayOfWeek = nowInPacific.getDay();
    const daysUntilTuesday = (2 - dayOfWeek + 7) % 7;

    // If today is Tuesday and past 10:30 AM PT, go to next Tuesday
    let nextTuesday = new Date(nowInPacific);
    if (dayOfWeek === 2 && (nowInPacific.getHours() > 10 || (nowInPacific.getHours() === 10 && nowInPacific.getMinutes() >= 30))) {
      nextTuesday.setDate(nowInPacific.getDate() + 14);
    } else {
      nextTuesday.setDate(nowInPacific.getDate() + daysUntilTuesday);
    }

    // Set to 10 AM Pacific time
    nextTuesday.setHours(10, 0, 0, 0);

    // If still in the past, add 2 weeks
    if (nextTuesday.getTime() <= nowInPacific.getTime() - 30 * 60 * 1000) {
      nextTuesday.setDate(nextTuesday.getDate() + 14);
    }

    // Format for display in Pacific timezone
    const formatter = new Intl.DateTimeFormat('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      timeZone: pacificTimezone,
      timeZoneName: 'short',
    });

    targetElement.textContent = formatter.format(nextTuesday);
  }

  calculateAndDisplayNextOfficeHours(elementId);

  document.addEventListener('astro:page-load', () => {
    calculateAndDisplayNextOfficeHours(elementId);
  });
</script>