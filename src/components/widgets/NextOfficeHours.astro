---
// src/components/NextOfficeHours.astro

const uniqueId = `next-office-hours-${crypto.randomUUID().slice(0, 8)}`;
---

<span id={uniqueId}>Loading next office hours...</span>

<script define:vars={{ elementId: uniqueId }}>
  function calculateAndDisplayNextOfficeHours(targetElementId) {
    const targetElement = document.getElementById(targetElementId);
    if (!targetElement) return;

    const pacificTimezone = 'America/Los_Angeles';

    // Get current UTC time
    const now = new Date();

    // Use Intl to get current hour in Pacific timezone
    const getPacificHour = () => {
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: pacificTimezone,
        hour: 'numeric',
        hour12: false,
      });
      return parseInt(formatter.format(now));
    };

    const pacificHour = getPacificHour();

    // Get day of week in Pacific
    const getPacificDayOfWeek = () => {
      const formatter = new Intl.DateTimeFormat('en-US', {
        timeZone: pacificTimezone,
        weekday: 'short',
      });
      const dayStr = formatter.format(now);
      const days = { 'Sun': 0, 'Mon': 1, 'Tue': 2, 'Wed': 3, 'Thu': 4, 'Fri': 5, 'Sat': 6 };
      return days[dayStr];
    };

    const dayOfWeek = getPacificDayOfWeek();
    const daysUntilTuesday = (2 - dayOfWeek + 7) % 7;

    // If today is Tuesday and past 10:30 AM PT, go to next Tuesday
    let nextTuesday = new Date(now);
    if (dayOfWeek === 2 && (pacificHour > 10 || (pacificHour === 10 && now.getMinutes() >= 30))) {
      nextTuesday.setDate(now.getDate() + 14);
    } else {
      nextTuesday.setDate(now.getDate() + daysUntilTuesday);
    }

    // Set to 10 AM (we need to adjust for timezone offset)
    // Pacific is UTC-8 in winter, UTC-7 in summer
    // We'll just set hours in local time and the formatter will display correctly
    nextTuesday.setHours(10, 0, 0, 0);

    // If still in the past, add 2 weeks
    if (nextTuesday.getTime() <= now.getTime() - 30 * 60 * 1000) {
      nextTuesday.setDate(nextTuesday.getDate() + 14);
    }

    // Format for display using the correct timezone
    const formatter = new Intl.DateTimeFormat('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      timeZone: pacificTimezone,
      timeZoneName: 'short',
    });

    targetElement.textContent = formatter.format(nextTuesday);
  }

  calculateAndDisplayNextOfficeHours(elementId);

  document.addEventListener('astro:page-load', () => {
    calculateAndDisplayNextOfficeHours(elementId);
  });
</script>