---
// src/components/NextOfficeHours.astro

const uniqueId = `next-office-hours-${crypto.randomUUID().slice(0, 8)}`;
---

<span id={uniqueId}>Loading next office hours...</span>

<script define:vars={{ elementId: uniqueId }}>
  function calculateAndDisplayNextOfficeHours(targetElementId) {
    const targetElement = document.getElementById(targetElementId);
    if (!targetElement) return;

    const pacificTimezone = 'America/Los_Angeles';
    const now = new Date();

    // Map weekdays to numbers
    const daysMap = { 'Sun': 0, 'Mon': 1, 'Tue': 2, 'Wed': 3, 'Thu': 4, 'Fri': 5, 'Sat': 6 };

    // Get current Pacific weekday
    const pacificWeekday = new Intl.DateTimeFormat('en-US', {
      timeZone: pacificTimezone,
      weekday: 'short'
    }).format(now);

    const dayOfWeek = daysMap[pacificWeekday];

    // Days until next Tuesday
    const daysUntilTuesday = (2 - dayOfWeek + 7) % 7;

    // Start with next Tuesday
    const nextTuesday = new Date(now);
    nextTuesday.setDate(nextTuesday.getDate() + daysUntilTuesday);

    // Push one more week forward
    nextTuesday.setDate(nextTuesday.getDate() + 7);

    // Set hours to 10:00 AM Pacific safely using Intl
    const displayFormatter = new Intl.DateTimeFormat('en-US', {
      weekday: 'long',
      month: 'long',
      day: 'numeric',
      year: 'numeric',
      hour: 'numeric',
      minute: '2-digit',
      hour12: true,
      timeZone: pacificTimezone,
      timeZoneName: 'short'
    });

    // Use a temporary string + parse to get DST-safe 10AM
    const parts = displayFormatter.formatToParts(nextTuesday);
    const pacificYear = parts.find(p => p.type === 'year').value;
    const pacificMonth = parts.find(p => p.type === 'month').value;
    const pacificDay = parts.find(p => p.type === 'day').value;

    // Build DST-safe date string
    const dstSafeDate = new Date(`${pacificMonth} ${pacificDay}, ${pacificYear} 10:00:00 ${pacificTimezone}`);
    targetElement.textContent = displayFormatter.format(dstSafeDate);
  }

  calculateAndDisplayNextOfficeHours(elementId);

  document.addEventListener('astro:page-load', () => {
    calculateAndDisplayNextOfficeHours(elementId);
  });
</script>