---
import { Icon } from 'astro-icon/components';
import { SITE } from 'astrowind:config';
import { getHomePermalink } from '~/utils/permalinks';
import Image from '~/components/common/Image.astro';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks: Array<Link>;
  footNote?: string;
  funding?: { logo?: { src: string; alt: string }; text?: string };
  theme?: string;
}

const { socialLinks = [], secondaryLinks = [], links = [], footNote = '', funding, theme = 'light' } = Astro.props;
---

<footer class:list={[{ dark: theme === 'dark' }, 'relative not-prose border-t border-hairline bg-sunken']}>
  <div
    class="relative mx-auto max-w-7xl px-4 sm:px-6"
  >
    <div class="grid grid-cols-12 gap-4 gap-y-8 py-10 sm:gap-8 md:py-14">
      <div class="col-span-12 lg:col-span-4">
        <div class="mb-3">
          <a class="inline-block font-display text-lg font-bold text-heading" href={getHomePermalink()}>
            {SITE?.name}
          </a>
        </div>
        <div class="flex flex-wrap gap-x-1 text-sm text-muted">
          {
            secondaryLinks.map(({ text, href }, index) => (
              <>
                {index !== 0 ? ' · ' : ''}
                <a class="link-quiet" href={href} set:html={text} />
              </>
            ))
          }
        </div>
      </div>
      {
        links.map(({ title, links }) => (
          <div class="col-span-6 md:col-span-3 lg:col-span-2">
            <div class="mb-3 text-eyebrow uppercase text-heading">{title}</div>
            {/* Links carry inline-block + py-1 so these stacked nav items hit a
                24px+ tap target on mobile (WCAG 2.5.8). */}
            {links && Array.isArray(links) && links.length > 0 && (
              <ul class="space-y-1 text-sm">
                {links.map(({ text, href, ariaLabel }) => (
                  <li>
                    <a
                      class="inline-block py-1 text-muted transition-colors hover:text-link"
                      href={href}
                      aria-label={ariaLabel}
                    >
                      <Fragment set:html={text} />
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))
      }
    </div>

    {
      /* Funding acknowledgement. Real markup, so the NSF logo goes through
         Astro's <Image> rather than a raw <img> into static/. */
      funding && (
        <div class="flex flex-col items-start gap-5 border-t border-hairline py-8 sm:flex-row sm:items-center">
          {funding.logo && (
            <Image
              src={funding.logo.src}
              alt={funding.logo.alt}
              class="h-16 w-16 shrink-0 object-contain"
              widths={[80, 160]}
              sizes="80px"
              width={80}
              height={80}
              loading="lazy"
            />
          )}
          {funding.text && <p class="text-sm text-muted">{funding.text}</p>}
        </div>
      )
    }

    <div class="flex flex-col gap-4 border-t border-hairline py-6 md:flex-row md:items-center md:justify-between">
      {
        socialLinks?.length ? (
          <ul class="-ml-2 flex md:order-1">
            {socialLinks.map(({ ariaLabel, href, text, icon }) => (
              <li>
                <a
                  class="inline-flex items-center rounded-md p-2.5 text-sm text-muted transition-colors hover:bg-surface-2 hover:text-link focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                  aria-label={ariaLabel}
                  href={href}
                >
                  {icon && <Icon name={icon} class="h-5 w-5" />}
                  <Fragment set:html={text} />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          ''
        )
      }

      {footNote && <div class="text-sm text-muted" set:html={footNote} />}
    </div>
  </div>
</footer>
