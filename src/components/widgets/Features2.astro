---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid2 from '~/components/ui/ItemGrid2.astro';
import type { Features as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  titleAs,
  items = [],
  columns = 3,
  defaultIcon,

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  width,
  rhythm,
  surface,
} = Astro.props;
---

{
  /* Width comes from WidgetWrapper. The hardcoded max-w-7xl here overrode it,
    which is why this section's content edge sat 128px wider than its
    neighbours'. See DESIGN.md section 4. */
}
<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={classes?.container ?? ''}
  bg={bg}
  width={width}
  rhythm={rhythm}
  surface={surface}
>
  <Headline
    titleAs={titleAs}
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={classes?.headline as Record<string, string>}
  />
  <ItemGrid2
    items={items}
    columns={columns}
    defaultIcon={defaultIcon}
    classes={{
      container: 'gap-4 md:gap-6',
      panel: 'card p-6',
      // panel:
      icon: 'w-11 h-11 mb-5 p-2.5 rounded-md bg-teal-700 text-white dark:bg-teal-400 dark:text-teal-950',
      ...((classes?.items as Record<string, never>) ?? {}),
    }}
  />
</WidgetWrapper>
