---
import WidgetWrapper from '../ui/WidgetWrapper.astro';
import type { CallToAction, Widget } from '~/types';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';

interface Props extends Widget {
  title?: string;
  subtitle?: string;
  tagline?: string;
  callToAction?: CallToAction;
  actions?: string | CallToAction[];
}

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline = await Astro.slots.render('tagline'),
  titleAs,
  actions = await Astro.slots.render('actions'),

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
  width,
  rhythm,
  surface,
} = Astro.props;
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={classes?.container ?? ''}
  bg={bg}
  width={width}
  rhythm={rhythm}
  surface={surface}
>
  {/* No spectrum rule here. It used to sit on this card's top edge, which made
      two per page once the hero also carried one -- and the hero's is the
      signature. One per page, in the hero. DESIGN.md section 6. */}
  <div class="card mx-auto max-w-3xl p-8 text-center md:p-12">
    <Headline
      align="center"
      titleAs={titleAs}
      title={title}
      subtitle={subtitle}
      tagline={tagline}
      classes={{
        container: 'mb-0 md:mb-0',
        subtitle: 'text-lead text-muted',
      }}
    />
    {
      actions && (
        <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
          {Array.isArray(actions) ? (
            actions.map((action) => <Button {...(action || {})} class="w-full sm:w-auto" />)
          ) : (
            <Fragment set:html={actions} />
          )}
        </div>
      )
    }
  </div>
</WidgetWrapper>
