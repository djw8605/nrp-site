---
import Image from '~/components/common/Image.astro';
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),

  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),

  id,
  bg = await Astro.slots.render('bg'),
  bgImage = await Astro.slots.render('bgImage'),
} = Astro.props;
---

<section class="relative not-prose overflow-hidden" {...id ? { id } : {}}>
  <div class="absolute inset-0 pointer-events-none -z-[1]" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
      {
        bgImage ? (
          /* layout="cover" avoids both the constrained layout's forced 2x
             upscale and fullWidth's inline intrinsic height -- see the note in
             Hero.astro. */
          <Image
            class="brightness-50 object-cover object-center w-full h-full"
            loading="lazy"
            layout="cover"
            widths={[640, 960, 1280, 1920]}
            sizes="100vw"
            {...bgImage}
          />
        ) : null
      }
    </slot>
  </div>

  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <div class="section">
      <div class="mx-auto max-w-3xl text-center">
        {
          /* The kicker + spectrum rule that used to open this block are gone:
             no eyebrows above headings, and the signature belongs to the page
             hero alone. `tagline` is accepted and inert, as in Headline. */
        }
        {
          /* h2, not h1: this is a section heading on pages that already have a
             hero. Emitting h1 here gave the homepage two. */
          title && <h2 class="font-display text-h2 font-bold text-heading" set:html={title} />
        }
        {subtitle && <p class="mx-auto mt-4 max-w-2xl text-lead text-muted" set:html={subtitle} />}
        {
          actions && (
            <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
              {Array.isArray(actions) ? (
                actions.map((action) => <Button {...(action || {})} class="w-full sm:w-auto" />)
              ) : (
                <Fragment set:html={actions} />
              )}
            </div>
          )
        }
        {content && <Fragment set:html={content} />}
      </div>

      {
        image && (
          <div class="mt-12">
            {typeof image === 'string' ? (
              <Fragment set:html={image} />
            ) : (
              <Image
                class="mx-auto w-full rounded-lg"
                layout="responsive"
                widths={[400, 768, 1024, 1536]}
                sizes="(max-width: 1023px) 100vw, 1024px"
                loading="lazy"
                {...image}
              />
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
