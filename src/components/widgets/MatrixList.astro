---
// Full list view of Matrix news - no carousel, all messages listed
---

<div class="matrix-list" id="matrix-list">
  <div class="list-loading" id="list-loading">
    <div class="loading-card">
      <div class="author-avatar bg-blue-500">?</div>
      <div class="slide-meta">
        <span class="author-name">Loading...</span>
        <span class="post-time">Please wait</span>
      </div>
      <div class="loading-content">Fetching latest news...</div>
    </div>
  </div>
</div>

<script>
function initMatrixList() {
  var container = document.getElementById('matrix-list');
  var loading = document.getElementById('list-loading');
  if (!container) return;

  var authorMap = {
    'ddiaz': 'Daniel (NRP Admin)',
    'msada': 'Mohammad (NRP Admin)',
    'dimm': 'Dmitry (NRP Admin)',
    'ehfd': 'Seungmin (NRP Admin)'
  };

  var colorMap = ['bg-blue-500', 'bg-purple-500', 'bg-emerald-500', 'bg-orange-500', 'bg-indigo-500', 'bg-rose-500'];

  function getAuthor(sender) {
    var m = sender.match(/^@([^:]+):/);
    var u = m ? m[1] : sender;
    return authorMap[u] || u;
  }

  function getColor(sender) {
    var h = 0;
    for (var i = 0; i < sender.length; i++) h = sender.charCodeAt(i) + ((h << 5) - h);
    return colorMap[Math.abs(h) % colorMap.length];
  }

  function formatTime(ts) {
    var d = new Date(ts), n = new Date(), diff = n - d;
    var mins = Math.floor(diff / 60000);
    var hrs = Math.floor(diff / 3600000);
    var days = Math.floor(diff / 86400000);
    if (mins < 1) return 'Just now';
    if (mins < 60) return mins + 'm ago';
    if (hrs < 24) return hrs + 'h ago';
    if (days < 7) return days + 'd ago';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function formatContent(html, body) {
    if (!html && body) {
      var t = body.startsWith('* ') ? body.slice(2) : body;
      return t.replace(/\n/g, '<br>').replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank">$1</a>');
    }
    if (html) {
      return html.replace(/^\*\s*/, '').replace(/\n/g, '<br>').replace(/(https?:\/\/[^\s]+)/g, '<a href="$1" target="_blank">$1</a>');
    }
    return '';
  }

  function render(messages) {
    if (loading) loading.style.display = 'none';

    if (!messages || messages.length === 0) {
      container.innerHTML = '<div class="empty-message">No news messages available. Check Matrix for updates.</div>';
      return;
    }

    // Sort newest first
    messages.sort(function(a, b) { return b.origin_server_ts - a.origin_server_ts; });

    var html = '';
    messages.forEach(function(msg, i) {
      var c = msg.content || {};
      var content = formatContent(c.formatted_body, c.body);
      var author = getAuthor(msg.sender);
      var time = formatTime(msg.origin_server_ts);
      var color = getColor(msg.sender);

      html += '<div class="news-card">' +
        '<div class="news-header">' +
          '<div class="author-avatar ' + color + '">' + author.charAt(0).toUpperCase() + '</div>' +
          '<div class="news-meta">' +
            '<span class="author-name">' + author + '</span>' +
            '<span class="post-time">' + time + '</span>' +
          '</div>' +
        '</div>' +
        '<div class="news-content">' + content + '</div>' +
      '</div>';
    });

    container.innerHTML = html;
  }

  fetch('/api/matrix-feed')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success && data.messages && data.messages.length > 0) {
        render(data.messages);
      } else {
        render([]);
      }
    })
    .catch(function(e) {
      console.error('Failed to fetch news:', e);
      render([]);
    });
}

document.addEventListener('DOMContentLoaded', initMatrixList);
document.addEventListener('astro:page-load', initMatrixList);
</script>

<style is:global>
.matrix-list { --feed-bg: #ffffff; --feed-border: #e5e7eb; --feed-text: #1f2937; --feed-text-muted: #6b7280; --card-bg: #f9fafb; }
.dark .matrix-list { --feed-bg: #111827; --feed-border: #374151; --feed-text: #f3f4f6; --feed-text-muted: #9ca3af; --card-bg: #1f2937; }
.matrix-list { width: 100%; display: flex; flex-direction: column; gap: 16px; }

.news-card { background: var(--card-bg); border: 1px solid var(--feed-border); border-radius: 12px; padding: 20px; animation: slideIn 0.3s ease; }
.news-card:hover { border-color: #3b82f6; transition: border-color 0.2s; }
@keyframes slideIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

.news-header { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
.author-avatar { width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 16px; flex-shrink: 0; }
.news-meta { display: flex; flex-direction: column; gap: 2px; }
.author-name { font-weight: 700; color: var(--feed-text); font-size: 15px; }
.post-time { font-size: 12px; color: var(--feed-text-muted); }
.news-content { color: var(--feed-text); font-size: 14px; line-height: 1.7; }
.news-content a { color: #3b82f6; text-decoration: none; }
.news-content a:hover { text-decoration: underline; }
.news-content strong { font-weight: 700; }

.loading-card { display: flex; align-items: center; gap: 12px; padding: 20px; background: var(--card-bg); border: 1px solid var(--feed-border); border-radius: 12px; }
.loading-content { color: var(--feed-text-muted); font-size: 14px; }

.empty-message { text-align: center; padding: 40px; color: var(--feed-text-muted); font-size: 15px; background: var(--card-bg); border: 1px solid var(--feed-border); border-radius: 12px; }

@media (max-width: 640px) {
  .news-card { padding: 16px; }
  .author-avatar { width: 36px; height: 36px; font-size: 14px; }
}
</style>