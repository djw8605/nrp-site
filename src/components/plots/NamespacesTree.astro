<!-- The page (src/pages/viz/namespaces.astro) owns the <h1>; this component
     used to emit its own, giving the page two. -->
<div id="graph-plot" class="flex flex-col justify-between sm:flex-row"></div>

<script>
  import * as Plot from '@observablehq/plot';
  import { RequestManager, HTTPTransport, Client } from '@open-rpc/client-js';
  const baseUrl = import.meta.env.PUBLIC_SVC_URL;
  const transport = new HTTPTransport(baseUrl + '/rpc');
  const client = new Client(new RequestManager([transport]));
  const namespaces = await client.request({ method: 'guest.ListNsTree' });
  const calculatedHeight = namespaces.Namespaces.length * 15;

  const plot = Plot.plot({
    width: 1600,
    height: calculatedHeight,
    margin: 10,
    marginLeft: 80,
    marginRight: 360,
    style: 'font-size: 1em',
    axis: null,
    marks: [
      Plot.tree(namespaces.Namespaces, {
        path: 'Name',
        delimiter: '/',
        treeSort: 'node:name',
        title: '',
        symbol: (node) => {
          if (node.IsK8sNamespace && node.IsLiteLLMOrg) {
            return 'hexagon';
          } else if (node.IsK8sNamespace) {
            return 'square';
          } else if (node.IsLiteLLMOrg) {
            return 'triangle-up';
          } else {
            return 'circle';
          }
        },
      }),
    ],
  });

  const div = document.querySelector('#graph-plot');
  div.append(plot);
</script>

<style is:global>
  #graph-plot text {
    stroke: white;
  }
  html.dark #graph-plot text {
    stroke: black;
  }
</style>
