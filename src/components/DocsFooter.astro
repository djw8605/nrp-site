---
import Default from '@astrojs/starlight/components/Footer.astro';
import type { Props } from '@astrojs/starlight/props';

/**
 * Forward the whole route-data object. Hand-listing props here silently drops
 * the ones Starlight's own children read from `Astro.props` — `lastUpdated` and
 * `lang` feed the `LastUpdated` component, so enumerating a subset switched the
 * per-page freshness date off without any error.
 */
---

<div>
  <Default {...Astro.props}>
    <slot />
  </Default>

  <!-- NSF Acknowledgment Section -->
  <div class="flex items-center justify-between mt-8 gap-2">
    <!-- NSF Logo -->
    <div class="flex items-center">
      <img
        src="/nsf-logo.png" 
        alt="NSF Logo"
        class="h-20 w-auto object-contain"
      />
    </div>
  
    <!-- Footer Text -->
    <div class="text-sm text-gray-600 dark:text-gray-400">
        This work was supported in part by National Science Foundation (NSF) awards CNS-1730158, ACI-1540112, ACI-1541349, OAC-1826967, OAC-2112167, CNS-2100237, CNS-2120019.
    </div>
  </div>
</div>
