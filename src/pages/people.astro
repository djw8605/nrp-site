  title="People"
  subtitle="People who make this project possible."
  people={[
    {
      img: '~/assets/images/people/frank-1.png',
      name: 'Frank Würthwein - PI',
      title: 'Executive Director of Open Science Grid - Director of SDSC',
    },
    {
      img: '~/assets/images/people/tajana-rosing.jpg',
      name: 'Tajana Rosing - Co-PI',
      title: 'Professor - ECE, UCSD',
    },
    {
      img: '~/assets/images/people/tom-sm.png',
      name: 'Tom DeFanti - Co-PI',
      title: 'Research Scientist - Calit2 / Qualcomm Institute - UCSD',
    },
    {
      img: '~/assets/images/people/TatineniMahi.jpg',
      name: 'Mahidhar Tatineni - Co-PI',
      title: 'User Support Group Lead - SDSC',
    },
    {
      img: '~/assets/images/people/D.weitzel.jpg',
      name: 'Derek Weitzel - Co-PI',
      title: 'Research Assistant Professor Computer Science & Engineering - U of NE–Lincoln',
    },
    {
      img: '~/assets/images/people/ilkay_bio_photo.png',
      name: 'Ilkay Altintas',
      title: 'Chief Data Science Officer - SDSC',
    },
  ]}
/>
</Layout>

