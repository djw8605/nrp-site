---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Storage',
};
---

<Layout metadata={metadata}>

  <section class="py-8 sm:py-16 lg:py-20 mx-auto">
    <article id="observablehq-plot-af1b9af6" class="flex justify-between flex-col sm:flex-row max-w-6xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center">
    </article>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@observablehq/inspector@5/dist/inspector.css">
    <script type="module">
    import {Runtime, Inspector} from "https://cdn.jsdelivr.net/npm/@observablehq/runtime@5/dist/runtime.js";
    import define from "https://api.observablehq.com/d/f2f8ca16077504f1.js?v=3";
    new Runtime().module(define, name => {
      if (name === "plot") return new Inspector(document.querySelector("#observablehq-plot-af1b9af6"));
    });
    </script>  
  </section>
</Layout>
