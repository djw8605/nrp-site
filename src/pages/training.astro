---
import Layout from '~/layouts/PageLayout.astro';
import NextOfficeHours from '~/components/widgets/NextOfficeHours.astro';

const metadata = {
  title: 'NRP Office Hours',
};
---

<Layout metadata={metadata}>
  <section class="py-16 bg-blue-50 dark:bg-slate-800">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-blue-800 dark:text-blue-200 mb-6">NRP Office Hours</h1>
      
      <p class="text-lg text-slate-700 dark:text-slate-200 mb-8">Join our regular office hours to get help with the NRP, ask questions, and connect with the community. Our team is here to support your research and education needs.</p>
      <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-8 max-w-2xl mx-auto">
        <h2 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-4">Next Office Hours</h2>
        <p class="text-lg text-gray-700 dark:text-gray-300 mb-6">
          Ready to learn more about the NRP and how to get started? Join our office hours on <NextOfficeHours/>.
        </p>
        <a href="https://ucsd.zoom.us/j/96377381436" 
           class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 px-8 rounded-lg text-lg shadow-lg transition" 
           target="_blank" rel="noopener">
          Join Office Hours
        </a>
      </div>
    </div>
  </section>


  <!-- Office Hours Information Section -->
  <section class="py-12">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-blue-800 dark:text-blue-200 mb-8 text-center">What to Expect at Office Hours</h2>
      
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-bold text-blue-800 dark:text-blue-200 mb-4">Get Help</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Get personalized assistance with NRP setup, troubleshooting, and best practices from our experienced team.
          </p>
        </div>
        
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-bold text-blue-800 dark:text-blue-200 mb-4">Ask Questions</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Bring your questions about using JupyterHub, Coder, Kubernetes, or any other NRP services.
          </p>
        </div>
        
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-6">
          <h3 class="text-xl font-bold text-blue-800 dark:text-blue-200 mb-4">Connect</h3>
          <p class="text-gray-600 dark:text-gray-300">
            Meet other researchers and educators using the NRP platform and share experiences.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources Section -->
  <section class="py-12 bg-blue-50 dark:bg-slate-800">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <h2 class="text-3xl font-bold text-blue-800 dark:text-blue-200 mb-8 text-center">Additional Resources</h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-8">
          <h3 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-4">Documentation</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Comprehensive guides and tutorials for getting started with the NRP platform.
          </p>
          <a href="/documentation" 
             class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition" 
             target="_blank" rel="noopener">
            View Documentation
          </a>
        </div>
        
        <div class="bg-white dark:bg-slate-800 rounded-lg shadow-lg p-8">
          <h3 class="text-2xl font-bold text-blue-800 dark:text-blue-200 mb-4">Community</h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6">
            Join our community discussions and get help from other users and the NRP team.
          </p>
          <a href="/contact" 
             class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg transition" 
             target="_blank" rel="noopener">
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>