---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';

const metadata = {
  title: 'Distributed Infrastructure',
};
---

<Layout metadata={metadata} id="distributed-infrastructure">
  {
    /* "Learn how it works" used to point at #features -- an anchor jump one
      screen down, which is not an action. Both CTAs now go somewhere. */
  }
  <Hero
    align="left"
    split={true}
    actions={[
      {
        text: 'Contribute hardware',
        href: '/documentation/admindocs/participating/new-contributor-guide/',
        variant: 'primary',
      },
      { text: 'Network requirements', href: '/documentation/admindocs/participating/network', variant: 'secondary' },
    ]}
  >
    <Fragment slot="title">Distributed Infrastructure</Fragment>

    <Fragment slot="subtitle">
      Over 400 nodes at more than 70 sites on three continents, running one Kubernetes API. Institutions contribute
      hardware and keep priority on it; everyone else gets opportunistic access to the rest.
    </Fragment>

    <Fragment slot="image">
      {
        /* Cross-origin iframe: cannot be themed and will not follow dark mode.
          Constrained to an aspect box so it stops shifting layout, and given
          the same hairline + rounded-lg treatment as every other media panel.
          Replacing it with a self-hosted D3 map (src/components/plots/) would
          make it themeable -- see the same note in src/pages/index.astro. */
      }
      {
        /* 4:3 rather than the homepage's 2:1 -- in the hero's split column this
          box is ~520px wide, and 2:1 would leave a 260px-tall letterbox. */
      }
      <div
        class="relative w-full overflow-hidden rounded-lg border border-hairline bg-surface-2 aspect-[16/10] lg:aspect-[4/3]"
      >
        <iframe
          src="https://dash.nrp-nautilus.io/map"
          title="Map of NRP sites"
          loading="lazy"
          class="absolute inset-0 h-full w-full border-0"
          allowfullscreen></iframe>
      </div>
    </Fragment>
  </Hero>

  <Features
    id="features"
    surface={1}
    title="What distribution buys you"
    columns={3}
    items={[
      {
        title: 'Standardized environments',
        description:
          'Control software and configurations across sites using containerized images for consistency and reproducibility.',
        icon: 'tabler:brand-docker',
      },
      {
        title: 'Industry-standard orchestration API',
        description:
          'A standardized Kubernetes API and resource model make it easy to develop, deploy, and integrate services using familiar primitives (Deployments, Services, ConfigMaps).',
        icon: 'tabler:api',
      },
      {
        title: 'Fault tolerance',
        description:
          'Distributed sites reduce single points of failure so experiments and services remain available even when individual nodes or even <strong>entire sites</strong> go offline.',
        icon: 'tabler:cloud-check',
      },
      {
        title: 'Data locality',
        description:
          'Keep data close to compute to reduce latency and improve throughput for large datasets and real-time experiments.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Scalability',
        description:
          'Grow your workloads across multiple sites to access more CPU, GPU, and storage resources on demand.',
        icon: 'tabler:arrows-maximize',
      },
      {
        title: 'Secure networking & isolation',
        description:
          'Encrypted site-to-site links, network segmentation, and tenant isolation protect traffic and reduce the risk of lateral movement.',
        icon: 'tabler:shield-lock',
      },
    ]}
  />

  {
    /* This section also carried id="features" -- two elements with the same id
      on one page, which made the #features anchor ambiguous. */
  }
  <Content
    surface="page"
    title="How the Open Science Data Federation builds on the NRP"
    subtitle="OSDF hosts its national data-distribution network on NRP sites, without running the systems underneath it."
    items={[
      {
        title: 'Distributed caches',
        description:
          'OSDF caches sit at multiple NRP sites, so data is served from near the researcher rather than from one origin.',
        icon: 'tabler:database',
      },
      {
        title: 'Local origins',
        description:
          'Origins run on hardware near the data source, owned by the data provider, while the NRP handles service hosting.',
        icon: 'tabler:map-pin',
      },
    ]}
    callToAction={{
      text: 'Read about the OSDF',
      href: 'https://osg-htc.org/services/osdf',
      icon: 'tabler:chevron-right',
    }}
  >
    <Fragment slot="content">
      The <a class="link" href="https://osg-htc.org/services/osdf">Open Science Data Federation</a> connects disparate dataset
      repositories into a single nationwide distribution network. It runs its caches and origins on NRP infrastructure, which
      means the OSDF team ships data services rather than administering servers — and gets availability and low-latency access
      from the NRP's geographic spread for free.
    </Fragment>

    <Fragment slot="image">
      <div
        class="relative w-full overflow-hidden rounded-lg border border-hairline bg-surface-2 aspect-[4/3] md:aspect-[5/4]"
      >
        <iframe
          src="https://map.osg-htc.org/map/iframe?view=OpenScienceDataFederation#20.737115,-10.140436|1"
          title="Map of Open Science Data Federation caches and origins"
          loading="lazy"
          class="absolute inset-0 h-full w-full border-0"
          allowfullscreen></iframe>
      </div>
    </Fragment>
  </Content>
</Layout>
