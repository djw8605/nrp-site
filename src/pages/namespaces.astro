---
import Layout from '~/layouts/PageLayout.astro';
import Namespace from '~/components/widgets/Namespace.astro';

const metadata = {
  title: 'Namespaces',
};

import clientjs from '@open-rpc/client-js';
const transport = new clientjs.HTTPTransport("https://portal.nrp.ai/rpc");
const client = new clientjs.Client(new clientjs.RequestManager([transport]));
const allNamespaces = await client.request({method: 'guest.ListNsInfo', params: []}).then(res => res.Namespaces);
---

<Layout metadata={metadata}>
    {allNamespaces.map((ns) => (
        <Namespace namespace={ns}/>
    ))}
</Layout>