---
import Layout from '~/layouts/PageLayout.astro';
import NamespacesApp from '~/components/vue/namespaces/NamespacesApp.vue';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Namespaces',
  description: 'Find your NRP namespaces, manage who has access, and create join links for trainings.',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper rhythm="tight">
    <NamespacesApp client:only="vue" />
  </WidgetWrapper>
</Layout>
