// Verbatim from footerData.funding in src/navigation.ts — the same list, stated
// properly here instead of only as footer fine print.
const nsfAwards = [
  'CNS-1730158',
  'ACI-1540112',
  'ACI-1541349',
  'OAC-1826967',
  'OAC-2112167',
  'CNS-2100237',
  'CNS-2120019',
];
---

<Layout metadata={metadata}>
  <Hero align="left" stats={clusterStats}>
    <Fragment slot="title">A national platform, run by the people who use it</Fragment>

    <Fragment slot="subtitle">
      The National Research Platform is shared research computing — GPUs, storage, and hosted AI models — pooled across
      more than 70 institutions and offered free to U.S. nonprofit research and education. It is funded by the National
      Science Foundation and governed by the community that contributes to it.
    </Fragment>
  </Hero>

  {
    /* The NRP / Nautilus distinction, stated once, explicitly. DESIGN.md §12
      asks for exactly this: the two names appear throughout the site and the
      docs, and nothing had ever said what the difference was. */
  }
  <WidgetWrapper surface={1} title="NRP and Nautilus" titleAs="h2" width="content">
    <div class="grid gap-8 md:grid-cols-2 md:gap-12">
      <div class="card p-6">
        <h3 class="font-display text-h3 font-semibold text-heading">NRP is the platform</h3>
        <p class="mt-3 text-muted">
          The project, the community, and the shared pool of hardware. Institutions contribute nodes and keep priority
          on their own hardware; when they are not using it, everyone else gets opportunistic access. This is the name
          used in anything public-facing.
        </p>
      </div>
      <div class="card p-6">
        <h3 class="font-display text-h3 font-semibold text-heading">Nautilus is the cluster</h3>
        <p class="mt-3 text-muted">
          The Kubernetes cluster the NRP runs on. It is the name in the technical documentation, in hostnames like
          <code class="font-mono text-sm">nrp-nautilus.io</code>, and in the cluster tooling itself. If you are reading
          about pods and namespaces, you are reading about Nautilus.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <PeopleWidget
    surface="page"
    layout="feature"
    title="Who runs the NRP"
    subtitle="The award's principal investigator and co-principal investigators."
    people={leadership}
  />

  <PeopleWidget
    surface={1}
    title="Who builds and operates it"
    subtitle="Engineering, operations, user support, and project management across the participating institutions."
    people={team}
  />

  {
    /* Funding acknowledgement. Same seven awards as footerData.funding in
      src/navigation.ts -- if that list changes, change this one too. */
  }
  <WidgetWrapper surface="page" title="Supported by the NSF" titleAs="h2" width="content">
    <div class="card flex flex-col gap-6 p-6 sm:flex-row sm:items-start sm:gap-8 md:p-8">
      <Image
        src="~/assets/images/nsf-logo.png"
        alt="U.S. National Science Foundation"
        class="h-20 w-20 shrink-0 object-contain"
        widths={[80, 160]}
        sizes="80px"
        width={80}
        height={80}
        loading="lazy"
      />
      <div class="min-w-0">
        {/* max-w-xl: unconstrained this ran the full 926px card width (~116
            characters per line). max-w-2xl still gave ~82ch at this 16px size --
            the 2xl cap suits text-lead's 18px, not body copy. 576px lands ~70ch. */}
        <p class="max-w-xl text-muted">
          The National Research Platform is supported in part by the U.S. National Science Foundation under the
          following awards. Any opinions, findings, and conclusions or recommendations expressed on this site are those
          of the authors and do not necessarily reflect the views of the National Science Foundation.
        </p>
        <ul class="mt-5 flex flex-wrap gap-2" aria-label="NSF award numbers">
          {
            nsfAwards.map((award) => (
              <li class="rounded-md border border-hairline bg-surface-3 px-2.5 py-1 font-mono text-sm text-body">
                {award}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </WidgetWrapper>

  <WidgetWrapper surface={1} title="Institutions and how to join" titleAs="h2" width="content">
    <div class="grid gap-8 md:grid-cols-3">
      <div class="card p-6">
        <h3 class="font-display text-h3 font-semibold text-heading">Use the platform</h3>
        <p class="mt-3 text-muted">
          Free to researchers and educators at U.S. nonprofit institutions — community colleges included, not just R1
          universities.
        </p>
        <p class="mt-4">
          <Button variant="link" href="/documentation/userdocs/start/getting-started/">Getting started &rarr;</Button>
        </p>
      </div>
      <div class="card p-6">
        <h3 class="font-display text-h3 font-semibold text-heading">Contribute hardware</h3>
        <p class="mt-3 text-muted">
          We install the OS, configure the node, and handle upgrades — we just need IPMI access. Contributors get
          priority on their own hardware whenever they want it.
        </p>
        <p class="mt-4">
          <Button variant="link" href="/documentation/admindocs/participating/new-contributor-guide/">
            New contributor guide &rarr;
          </Button>
        </p>
      </div>
      <div class="card p-6">
        <h3 class="font-display text-h3 font-semibold text-heading">Who is already here</h3>
        <p class="mt-3 text-muted">
          Universities, national labs, and research organizations across three continents contribute nodes, network, and
          storage to the pool.
        </p>
        <p class="mt-4">
          <Button variant="link" href="/partners">See our partners &rarr;</Button>
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <CallToAction
    surface="page"
    title="Questions about the NRP?"
    subtitle="Come to bi-weekly office hours, join the support chat, or email the team directly."
    actions={[
      { variant: 'primary', text: 'Contact us', href: '/contact', icon: 'tabler:mail' },
      { variant: 'secondary', text: 'Meet the community', href: '/partners' },
    ]}
  />
</Layout>
