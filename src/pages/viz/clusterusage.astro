---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import ResourceUsage from '~/components/plots/ClusterUsage.astro';

const metadata = {
  title: 'Cluster Usage',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper
    titleAs="h1"
    title="Cluster usage"
    description="GPU and CPU utilisation across the cluster over time."
    rhythm="tight"
    width="wide"
  >
    <ResourceUsage />
  </WidgetWrapper>
</Layout>
