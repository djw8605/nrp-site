---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import StorageCeph from '~/components/plots/StorageCeph.astro';

const metadata = {
  title: 'Storage',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper
    titleAs="h1"
    title="Ceph storage"
    description="Capacity and utilisation of the Ceph pools."
    rhythm="tight"
    width="wide"
  >
    <StorageCeph />
  </WidgetWrapper>
</Layout>
