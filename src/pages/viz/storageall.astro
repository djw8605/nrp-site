---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import StorageAll from '~/components/plots/StorageAll.astro';

const metadata = {
  title: 'Storage',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper
    titleAs="h1"
    title="Storage by site"
    description="Capacity and utilisation for every storage backend."
    rhythm="tight"
    width="wide"
  >
    <StorageAll />
  </WidgetWrapper>
</Layout>
