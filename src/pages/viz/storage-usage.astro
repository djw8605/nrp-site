---
import Storage from '~/components/vue/Storage.vue';
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

export const baseUrl = import.meta.env.PUBLIC_SVC_URL;

const metadata = {
  title: 'Storage',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper
    titleAs="h1"
    title="Storage usage"
    description="Per-namespace consumption across the platform."
    rhythm="tight"
    width="wide"
  >
    <Storage client:only="vue" baseUrl={baseUrl} />
  </WidgetWrapper>
</Layout>
