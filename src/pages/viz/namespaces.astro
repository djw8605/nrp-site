---
import NamespacesTree from '~/components/plots/NamespacesTree.astro';
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'Namespaces Tree',
};
---

<Layout metadata={metadata}>
  <WidgetWrapper
    titleAs="h1"
    title="Namespaces tree"
    description="Every namespace on the cluster, grouped by owner."
    rhythm="tight"
    width="wide"
  >
    <NamespacesTree />
  </WidgetWrapper>
</Layout>
