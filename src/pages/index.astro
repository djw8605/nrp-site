---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import AnnouncementBar from '~/components/common/AnnouncementBar.astro';
import Image from '~/components/common/Image.astro';
import MatrixFeed from '~/components/widgets/MatrixFeed.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import HeroWide from '~/components/widgets/HeroWide.astro';
import NextOfficeHours from '~/components/widgets/NextOfficeHours.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'National Research Platform (NRP)',
  ignoreTitleTemplate: true,
};

// These figures are the site's strongest credibility signal, so they now sit
// in the hero rather than 83% of the way down the page. Shared with /about --
// see src/data/cluster-stats.ts.
import { clusterStats } from '~/data/cluster-stats';

const homepageAnnouncements = [
  {
    id: 'training-recordings',
    category: 'Training',
    title: 'NRP Training Recordings',
    tagline: 'Catch up on Docker, Kubernetes, JupyterHub and more from recent sessions.',
    ctaLabel: 'Watch Now',
    ctaUrl: '/training',
  },
  {
    id: 'office-hours',
    category: 'Office Hours',
    title: 'Bi-Weekly Office Hours',
    tagline: 'Get hands-on help from the NRP team to unblock your research workloads.',
    dateLocation: 'Next: …',
    ctaLabel: 'Join Meeting',
    ctaUrl: 'https://ucsd.zoom.us/j/96377381436',
  },
  {
    id: 'lightscope',
    category: 'Program',
    title: 'LightScope: Network Telescopes',
    tagline: 'Hardware contributors: opt-in to forward closed ports to distributed honeypots.',
    ctaLabel: 'Learn More',
    ctaUrl: '/lightscope',
  },
];
---

<Layout metadata={metadata} id="front-page">
  <!-- Hero ************************** -->
  <!-- The mission statement is the subtitle. It used to be a separate 56px
       strip below the hero, styled identically to the announcement bar. -->
  <Hero
    align="left"
    whiteText={true}
    bgImage={{ src: '~/assets/images/NRP_globe.jpg', alt: '' }}
    stats={clusterStats}
    actions={[
      { text: 'Get started', href: '/documentation/userdocs/start/getting-started/', variant: 'primary' },
      { text: 'Explore hosted LLMs', href: '/llms', variant: 'secondary' },
    ]}
  >
    <!-- Hero copy follows /about's framing, which reads better than the old
         feature-list pitch: say what the NRP *is* first, then who it is for. -->
    <Fragment slot="title">Shared research computing, run by the people who use it</Fragment>

    <Fragment slot="subtitle">
      The National Research Platform pools GPUs, petabyte-scale storage, and hosted open-weight AI models across more
      than 70 institutions. It is free to U.S. nonprofit research and education, funded by the National Science
      Foundation and governed by the community that contributes to it.
    </Fragment>
  </Hero>

  <!-- Announcements ***************** -->
  <!-- Below the hero, so it no longer pushes the <h1> down the page. Sits in a
       surface-1 band with real vertical rhythm and a hairline that continues the
       hero's bottom edge, rather than floating over the seam. -->
  <div class="border-b border-hairline bg-surface-1 py-6">
    <AnnouncementBar
      announcements={homepageAnnouncements}
      autoRotate={true}
      intervalMs={7000}
      dismissKey="nrp:home-announcement-bar-dismissed"
    />
  </div>

  <!-- NextOfficeHours script must run on the homepage to fill the announcement date -->
  <div class="sr-only" aria-hidden="true">
    <NextOfficeHours />
  </div>

  <!-- Features ********************** -->
  <Features
    id="features"
    title="What you can do here"
    surface="page"
    items={[
      {
        title: 'Artificial Intelligence',
        description:
          'Modern GPUs, FPGAs, and specialized hardware for AI research, plus a catalog of hosted open-weight models you can call from your own code.',
        icon: 'tabler:ai',
        callToAction: {
          text: 'Browse hosted models',
          href: '/llms',
        },
      },
      {
        title: 'Resources for the classroom',
        description:
          'GPUs, CPUs, and storage for educators, reachable through JupyterHub and Coder so students never have to touch Kubernetes.',
        icon: 'tabler:school',
        callToAction: {
          text: 'Teaching with the NRP',
          href: '/education',
        },
      },
      {
        title: 'Network experiments',
        description:
          'Nodes distributed across 70+ sites on three continents make measurements possible that no single-site cluster can support.',
        icon: 'tabler:network',
        callToAction: {
          text: 'View network dashboards',
          href: 'https://perfsonar.nrp-nautilus.io/maddash-webui/',
        },
      },
      {
        title: 'Large data pools',
        description:
          'Mount petabyte-scale S3 and Ceph storage from anywhere on the platform and use it directly in your workloads.',
        icon: 'tabler:server-2',
        callToAction: {
          text: 'Storage documentation',
          href: '/documentation/userdocs/storage/intro',
        },
      },
    ]}
  />

  <!-- Map of NRP sites ************** -->
  <HeroWide
    title="Distributed Infrastructure"
    subtitle="A global network of research resources: shared compute, data, and services."
    actions={[{ text: 'How the network works', href: '/distributed-infrastructure', variant: 'primary' }]}
  >
    <Fragment slot="image">
      <!-- Cross-origin iframe: cannot be themed and will not follow dark mode.
           Constrained to a fixed aspect box so it stops shifting layout.
           Replacing it with a self-hosted D3 map (see src/components/plots/)
           would make it themeable. -->
      <div
        class="relative w-full overflow-hidden rounded-lg border border-hairline bg-surface-2 aspect-[16/10] md:aspect-[2/1]"
      >
        <iframe
          src="https://dash.nrp-nautilus.io/map"
          title="Map of NRP sites"
          loading="lazy"
          class="absolute inset-0 h-full w-full border-0"
          allowfullscreen></iframe>
      </div>
    </Fragment>
  </HeroWide>

  <!-- Happening now ***************** -->
  <!-- Merges what used to be two separate hand-rolled <section> blocks, each
       with its own container width and ad-hoc Tailwind colors. -->
  <WidgetWrapper
    surface={1}
    rhythm="normal"
    title="Events and cluster activity"
    containerClass=""
  >
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Recent event -->
      <div>
        {/* "Recent event" was a kicker above this heading, with its own spectrum
            rule. The heading already says what this is. */}
        <h3 class="font-display text-h3 font-semibold text-heading">7NRP workshop media is now available</h3>
        <a href="/7nrp-workshop/" class="card-interactive mt-5 block overflow-hidden">
          <Image
            src="~/assets/images/posts/7nrp-overlap.png"
            alt="Seventh National Research Platform workshop at UC San Diego"
            class="h-full w-full object-cover"
            widths={[400, 768, 1024]}
            sizes="(max-width: 1023px) 100vw, 520px"
            width={768}
            aspectRatio="16:9"
            layout="cover"
          />
        </a>
        <p class="mt-4 text-muted">
          Browse the agenda, slides, tutorial materials, and session recordings from the Seventh National Research
          Platform workshop at UC San Diego.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-primary w-full sm:w-auto" href="/7nrp-workshop/">View workshop media</a>
          <a
            class="btn btn-secondary w-full sm:w-auto"
            href="https://www.youtube.com/playlist?list=PL3p1Zps9-ohCwhU6Ddapq-V8k68TGFkAA"
          >
            Watch playlist
          </a>
        </div>
      </div>

      <!-- Live cluster news -->
      <div>
        <div class="flex items-center justify-between gap-4">
          <div>
            {/* This one stays: a pulsing dot plus "Live" is a status indicator
                reporting that the feed below is current, not a kicker labelling
                the heading. Its spectrum rule is gone -- the signature belongs
                to the hero alone. */}
            <p class="eyebrow flex items-center gap-2">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75 motion-reduce:hidden"
                ></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-500"></span>
              </span>
              Live
            </p>
            <h3 class="mt-2 font-display text-h3 font-semibold text-heading">Latest cluster news</h3>
          </div>
          <a href="/live" class="link-quiet shrink-0 text-sm">View all →</a>
        </div>
        <div class="mt-5">
          <MatrixFeed />
        </div>
        <p class="mt-4 text-sm text-muted">
          Pulled from Nautilus Support chat. <a href="/contact/" class="link">Join the channel</a> for real-time updates.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <!-- Blog ************************** -->
  <BlogLatestPosts
    title="From the NRP blog"
    information="Recent events across the NRP and its collaborating projects."
    surface="page"
  />

  <!-- FAQs ************************** -->
  <FAQs
    title="Frequently asked questions"
    subtitle="What the NRP is, who can use it, and what it costs."
    surface={1}
    items={[
      {
        title: 'What is the difference between NRP and Nautilus?',
        description:
          'The NRP is the platform and the community. Nautilus is the Kubernetes cluster the NRP runs on, and the name you will see in technical documentation and in the cluster tooling itself.',
      },
      {
        title: 'How much does it cost?',
        description:
          'Nothing. We are funded by the U.S. National Science Foundation to provide free access to nonprofit research and education institutions.',
      },
      {
        title: 'Does my project fit here?',
        description:
          'If your work is part of a scientific project or educational use at a U.S. nonprofit institution, yes. That includes community colleges, not just R1 universities.',
      },
      {
        title: "What if I don't know Kubernetes?",
        description:
          'You do not need it. Hosted JupyterHub, Coder, and our inference API require no Kubernetes knowledge. Our tutorials and bi-weekly office hours cover the rest.',
      },
      {
        title: 'Why NRP rather than a commercial cloud?',
        description:
          'It is free to eligible institutions, it is governed by the research community that uses it, and its geographic distribution supports experiments that a single-region cloud cannot.',
      },
      {
        title: 'How can I help?',
        description:
          'Contribute hardware to the cluster, or help by spreading the word. Contributors get priority on their own nodes whenever they want them.',
      },
      {
        title: 'What do I get if I contribute hardware?',
        description:
          'Priority access to your own hardware whenever you need it. When your group is not using it, other NRP users get opportunistic access.',
      },
      {
        title: 'Do I have to administer hardware I contribute?',
        description:
          'No. We install the OS, configure the node, and handle upgrades ourselves; we just need IPMI access. Occasionally we may ask you to reboot a node or swap a drive.',
      },
    ]}
  />

  <!-- Call to action **************** -->
  <CallToAction
    surface="page"
    actions={[
      {
        variant: 'primary',
        text: 'Get started',
        href: '/documentation/userdocs/start/getting-started/',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'Contribute hardware',
        href: '/documentation/admindocs/participating/new-contributor-guide/',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="title">Start computing on the NRP</Fragment>

    <Fragment slot="subtitle">
      Bring your research to a platform built and governed by the people who use it.
    </Fragment>
  </CallToAction>
</Layout>
