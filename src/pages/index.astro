---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import AnnouncementBar from '~/components/common/AnnouncementBar.astro';
import Image from '~/components/common/Image.astro';
import MatrixFeed from '~/components/widgets/MatrixFeed.astro';
import CapabilityTabs from '~/components/widgets/CapabilityTabs.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import HeroWide from '~/components/widgets/HeroWide.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';

const metadata = {
  title: 'National Research Platform (NRP)',
  ignoreTitleTemplate: true,
};

// These figures are the site's strongest credibility signal, so they now sit
// in the hero rather than 83% of the way down the page. Shared with /about --
// see src/data/cluster-stats.ts.
import { clusterStats } from '~/data/cluster-stats';

// Office hours are no longer one of these: a rotating item that appeared for
// seven seconds in twenty-one, below the fold, was not a schedule anyone could
// rely on. It now has its own strip above the header -- see
// src/components/common/OfficeHoursBar.astro.
const homepageAnnouncements = [
  {
    id: 'training-recordings',
    category: 'Training',
    title: 'NRP Training Recordings',
    tagline: 'Catch up on Docker, Kubernetes, JupyterHub and more from recent sessions.',
    ctaLabel: 'Watch Now',
    ctaUrl: '/training',
  },
  {
    id: 'lightscope',
    category: 'Program',
    title: 'LightScope: Network Telescopes',
    tagline: 'Hardware contributors: opt-in to forward closed ports to distributed honeypots.',
    ctaLabel: 'Learn More',
    ctaUrl: '/lightscope',
  },
];

import type { Capability } from '~/components/widgets/CapabilityTabs.astro';

// The value proposition, directly under the hero. Four capabilities as tabs
// rather than the four-up icon grid that used to sit here: they are
// alternatives, not a sequence, and a visitor arrives wanting exactly one of
// them. See src/components/widgets/CapabilityTabs.astro for the composition
// notes.
//
// Every YAML fragment below is real -- lifted from our own documentation
// (userdocs/running/gpu-pods, jupyter/values, running/ingress) and trimmed to
// stay legible at a phone's width. Nothing here is illustrative: if a key
// changes in the docs, change it here too.
//
// Two of the four panels carry a screenshot of the real interface and two carry
// a manifest. Both screenshots are captures of the platform mid-task, not of an
// idle landing screen -- that distinction is the whole reason this section reads
// as a demonstration rather than a claim, so preserve it if either is replaced.
// The alt text on each describes that specific capture, so it has to be rewritten
// in the same edit as any swap.
const capabilities: Capability[] = [
  {
    id: 'jupyterhub',
    tab: 'Use Jupyter Notebooks',
    title: 'Use our hosted JupyterHub, or run your own',
    description:
      // Same length band as the other three descriptions, so all four panels
      // measure the same and the section does not jump on switch. The detail
      // trimmed off the end ("your own images, profiles, sign-in rules") is
      // stated by the spec rows directly below it.
      'Sign in with your institution and get a notebook server on shared GPUs \u2014 no setup, no Kubernetes. When a course or a lab needs more control, run a private hub with your own images, profiles, and sign-in rules.',
    specs: [
      { term: 'Hosted', value: 'Sign in, pick a profile, get a server' },
      { term: 'Your own', value: 'Your images, your profiles, your sign-in rules' },
      { term: 'Behind both', value: 'The same shared GPUs and CPUs as everything else' },
    ],
    actions: [
      { text: 'JupyterHub service guide', href: '/documentation/userdocs/jupyter/jupyterhub-service/' },
      { text: 'Teaching with the NRP', href: '/education' },
    ],
    // Replaced the values.yaml artifact this tab shipped with. The capture is a
    // real JupyterLab session on our own hub, cropped from 1644px to 1400px to
    // drop the empty canvas below the output cell. It shows the platform
    // composing with itself -- a notebook calling the NRP's own inference
    // endpoint -- which is a better argument than a Helm chart. The API key in
    // the visible cell is already the `sk-xxxx` placeholder.
    media: {
      kind: 'image',
      src: '~/assets/images/jupyterhub-notebook.png',
      framed: true,
      alt: 'A JupyterLab notebook running on the NRP, calling the platform’s own qwen3-small endpoint through LangChain and printing the tool call it returned',
    },
  },
  {
    id: 'gpus',
    tab: 'Train and serve models',
    title: 'Train and serve models on shared GPUs',
    description:
      // Held to roughly the same length as its siblings: a fifth line here made
      // this panel 29px taller than the others, so the section jumped when you
      // switched tabs. The "what is idle" nudge moved to the quiet link below,
      // where it was going to be read anyway.
      'Ask for GPUs by the card in a job manifest, or take a whole multi-GPU node \u2014 the scheduler holds 4- and 8-GPU machines back for jobs that need them. Pin a specific accelerator when your run needs the memory.',
    specs: [
      { term: 'Interface', value: '<code class="font-mono">kubectl</code>, or a browser IDE' },
      { term: 'Pick by', value: 'GPU product, CUDA runtime, region, or host' },
      { term: 'Also here', value: 'FPGAs and other specialized accelerators' },
    ],
    actions: [
      { text: 'GPU job documentation', href: '/documentation/userdocs/running/gpu-pods/' },
      { text: 'See what is idle right now', href: '/viz/resources/' },
    ],
    media: {
      kind: 'code',
      filename: 'train-job.yaml',
      command: 'kubectl apply -f train-job.yaml',
      lines: [
        { text: '# four GPUs on one node' },
        { text: 'apiVersion: batch/v1' },
        { text: 'kind: Job' },
        { text: 'spec:' },
        { text: '  template:' },
        { text: '    spec:' },
        { text: '      restartPolicy: Never' },
        { text: '      containers:' },
        { text: '        - name: train' },
        { text: '          image: pytorch/pytorch' },
        { text: '          resources:' },
        { text: '            limits:' },
        { text: '              nvidia.com/gpu: "4"', mark: true },
        { text: '              memory: 64Gi' },
        { text: '              cpu: "16"' },
      ],
    },
  },
  {
    id: 'llms',
    tab: 'Use open-weight LLMs',
    // Kept to one line at the panel's measure: a two-line h3 here made this
    // panel 28px taller than the other three and the section visibly jumped on
    // switch. "Frontier" carries in the description instead.
    title: 'Call open-weight models from your own code',
    description:
      'A rotating catalog of open-weight models runs on NRP hardware behind an OpenAI-compatible endpoint. Point any client at it with a personal API key, or skip the setup entirely and open the hosted chat interface in a browser.',
    specs: [
      { term: 'Endpoint', value: 'OpenAI-compatible, with per-user API keys' },
      {
        term: 'Models',
        value:
          '<code class="font-mono">qwen3</code> \u00b7 <code class="font-mono">kimi</code> \u00b7 <code class="font-mono">glm-5</code> \u00b7 <code class="font-mono">gpt-oss</code>',
      },
      { term: 'Clients', value: 'Open WebUI, Chatbox, or your coding CLI' },
    ],
    actions: [
      { text: 'Browse the model catalog', href: '/llms' },
      { text: 'Open the chat interface', href: 'https://nrp-openwebui.nrp-nautilus.io', external: true },
    ],
    // Its own capture rather than reusing /llms's `openwebui-hero.png`, which
    // was an idle landing screen showing Open WebUI's stock suggestions
    // ("Explain options trading") -- the one panel promising the interface at
    // work showed nothing being done. This one is a real exchange: the model
    // picker on `deepseek-v4-flash`, the tool-call rows it actually ran, and an
    // answer sourced from our own documentation.
    //
    // `framed` because this capture is opaque white to its own edges, unlike the
    // hero shot it replaced, which carried window chrome and a transparent
    // shadow. Uncropped on purpose: the dead space is the app's own margins
    // rather than empty canvas, and the composer and model picker at the bottom
    // are what keep it identifiable once it scales down.
    media: {
      kind: 'image',
      src: '~/assets/images/openwebui-example.png',
      framed: true,
      alt: 'The Open WebUI chat interface hosted on the NRP: deepseek-v4-flash answers a question about deploying JupyterHub, having searched the NRP documentation, and lists the CILogon setup steps',
    },
  },
  {
    id: 'services',
    tab: 'Host a service',
    // "long-running" came off the front: at 45 characters this title sat right
    // on the wrap boundary and fell to two lines in the production build while
    // staying on one in dev, which made the panel 28px taller than its siblings
    // only in the built site. The description's first sentence carries the
    // long-running point anyway.
    title: 'Host services close to your data',
    description:
      'Not everything is a batch job. Expose an HTTP service on its own nrp-nautilus.io hostname with TLS, then pin it to a region, a zone, or a single machine when it has to sit next to the instrument or the dataset it serves.',
    specs: [
      // Deliberately NOT the node/location/continent figures: the hero's stat
      // strip states them one screen above, and they are bound to
      // src/data/cluster-stats.ts, so a second hardcoded copy here would be a
      // third place to keep in sync.
      { term: 'Runs as', value: 'Deployments and StatefulSets, not just Jobs' },
      { term: 'Placement', value: 'By region, zone, or individual host' },
      { term: 'Ingress', value: 'HAProxy, with TLS on <code class="font-mono">*.nrp-nautilus.io</code>' },
    ],
    actions: [
      { text: 'How the network works', href: '/distributed-infrastructure' },
      // "Exposing HTTP" is the linked page's own title, and it is short enough
      // that the row fits on one line: at "Exposing HTTP over ingress" the pair
      // measured 477px inside a 475px row, so `sm:flex-wrap` did its job and
      // dropped the link to a second line -- correct behaviour, but it made this
      // one panel 36px taller than the other three.
      { text: 'Exposing HTTP', href: '/documentation/userdocs/running/ingress/' },
    ],
    media: {
      kind: 'code',
      filename: 'my-app.yaml',
      command: 'kubectl apply -f my-app.yaml',
      lines: [
        { text: '# your own hostname, with TLS' },
        { text: 'kind: Ingress' },
        { text: 'spec:' },
        { text: '  ingressClassName: haproxy' },
        { text: '  rules:' },
        { text: '    - host: my-app.nrp-nautilus.io', mark: true },
        { text: '  tls:' },
        { text: '    - hosts: [my-app.nrp-nautilus.io]' },
        { text: '---' },
        { text: '# running where the data already is' },
        { text: 'kind: Deployment' },
        { text: 'spec:' },
        { text: '  template:' },
        { text: '    spec:' },
        { text: '      nodeSelector:' },
        { text: '        topology.kubernetes.io/region: pacific', mark: true },
      ],
    },
  },
];
---

<Layout metadata={metadata} id="front-page">
  <!-- Hero ************************** -->
  <!-- The mission statement is the subtitle. It used to be a separate 56px
       strip below the hero, styled identically to the announcement bar. -->
  <Hero
    align="left"
    whiteText={true}
    bgImage={{ src: '~/assets/images/NRP_globe.jpg', alt: '' }}
    stats={clusterStats}
    actions={[
      { text: 'Get started', href: '/documentation/userdocs/start/getting-started/', variant: 'primary' },
      { text: 'Explore hosted LLMs', href: '/llms', variant: 'secondary' },
    ]}
  >
    <!-- Hero copy follows /about's framing, which reads better than the old
         feature-list pitch: say what the NRP *is* first, then who it is for. -->
    <Fragment slot="title">Shared research computing, run by the people who use it</Fragment>

    <Fragment slot="subtitle">
      The National Research Platform pools GPUs, petabyte-scale storage, and hosted open-weight AI models across more
      than 70 institutions. It is free to U.S. nonprofit research and education, funded by the National Science
      Foundation and governed by the community that contributes to it.
    </Fragment>
  </Hero>

  <!-- Value proposition ************* -->
  <!-- Directly under the hero, ahead of the announcement band, so the first
       thing to clear the fold after the headline is the row of four things a
       visitor can actually do here. `rhythm="tight"` for the same reason: the
       standard py-24 pushed the tab rail below 800px of viewport.

       This replaced the four-up icon grid ("What you can do here"). Two of its
       items -- petabyte storage and network experiments -- came off the homepage
       with it; both are still covered on /distributed-infrastructure and in the
       docs. -->
  <CapabilityTabs
    id="capabilities"
    surface="page"
    rhythm="tight"
    title="What can you do with the NRP?"
    items={capabilities}
  />

  <!-- Announcements ***************** -->
  <!-- Below the hero, so it no longer pushes the <h1> down the page. Sits in a
       surface-1 band with real vertical rhythm and a hairline that continues the
       hero's bottom edge, rather than floating over the seam. -->
  <div class="border-y border-hairline bg-surface-1 py-6">
    <AnnouncementBar
      announcements={homepageAnnouncements}
      autoRotate={true}
      intervalMs={7000}
      dismissKey="nrp:home-announcement-bar-dismissed"
    />
  </div>

  <!-- Map of NRP sites ************** -->
  <HeroWide
    title="Distributed Infrastructure"
    subtitle="A global network of research resources: shared compute, data, and services."
    actions={[{ text: 'How the network works', href: '/distributed-infrastructure', variant: 'primary' }]}
  >
    <Fragment slot="image">
      <!-- Cross-origin iframe: cannot be themed and will not follow dark mode.
           Constrained to a fixed aspect box so it stops shifting layout.
           Replacing it with a self-hosted D3 map (see src/components/plots/)
           would make it themeable. -->
      <div
        class="relative w-full overflow-hidden rounded-lg border border-hairline bg-surface-2 aspect-[16/10] md:aspect-[2/1]"
      >
        <iframe
          src="https://dash.nrp-nautilus.io/map"
          title="Map of NRP sites"
          loading="lazy"
          class="absolute inset-0 h-full w-full border-0"
          allowfullscreen></iframe>
      </div>
    </Fragment>
  </HeroWide>

  <!-- Happening now ***************** -->
  <!-- Merges what used to be two separate hand-rolled <section> blocks, each
       with its own container width and ad-hoc Tailwind colors. -->
  <WidgetWrapper surface={1} rhythm="normal" title="Events and cluster activity" containerClass="">
    <div class="grid gap-10 lg:grid-cols-2 lg:gap-14">
      <!-- Recent event -->
      <div>
        {
          /* "Recent event" was a kicker above this heading, with its own spectrum
            rule. The heading already says what this is. */
        }
        <h3 class="font-display text-h3 font-semibold text-heading">7NRP workshop media is now available</h3>
        <a href="/7nrp-workshop/" class="card-interactive mt-5 block overflow-hidden">
          <Image
            src="~/assets/images/posts/7nrp-overlap.png"
            alt="Seventh National Research Platform workshop at UC San Diego"
            class="h-full w-full object-cover"
            widths={[400, 768, 1024]}
            sizes="(max-width: 1023px) 100vw, 520px"
            width={768}
            aspectRatio="16:9"
            layout="cover"
          />
        </a>
        <p class="mt-4 text-muted">
          Browse the agenda, slides, tutorial materials, and session recordings from the Seventh National Research
          Platform workshop at UC San Diego.
        </p>
        <div class="mt-5 flex flex-col gap-3 sm:flex-row">
          <a class="btn btn-primary w-full sm:w-auto" href="/7nrp-workshop/">View workshop media</a>
          <a
            class="btn btn-secondary w-full sm:w-auto"
            href="https://www.youtube.com/playlist?list=PL3p1Zps9-ohCwhU6Ddapq-V8k68TGFkAA"
          >
            Watch playlist
          </a>
        </div>
      </div>

      <!-- Live cluster news -->
      <div>
        <div class="flex items-center justify-between gap-4">
          <div>
            {
              /* This one stays: a pulsing dot plus "Live" is a status indicator
                reporting that the feed below is current, not a kicker labelling
                the heading. Its spectrum rule is gone -- the signature belongs
                to the hero alone. */
            }
            <p class="eyebrow flex items-center gap-2">
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span
                  class="absolute inline-flex h-full w-full animate-ping rounded-full bg-teal-400 opacity-75 motion-reduce:hidden"
                ></span>
                <span class="relative inline-flex h-2 w-2 rounded-full bg-teal-500"></span>
              </span>
              Live
            </p>
            <h3 class="mt-2 font-display text-h3 font-semibold text-heading">Latest cluster news</h3>
          </div>
          <a href="/live" class="link-quiet shrink-0 text-sm">View all →</a>
        </div>
        <div class="mt-5">
          <MatrixFeed />
        </div>
        <p class="mt-4 text-sm text-muted">
          Pulled from Nautilus Support chat. <a href="/contact/" class="link">Join the channel</a> for real-time updates.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <!-- Blog ************************** -->
  <BlogLatestPosts
    title="From the NRP blog"
    information="Recent events across the NRP and its collaborating projects."
    surface="page"
  />

  <!-- FAQs ************************** -->
  <FAQs
    title="Frequently asked questions"
    subtitle="What the NRP is, who can use it, and what it costs."
    surface={1}
    items={[
      {
        title: 'What is the difference between NRP and Nautilus?',
        description:
          'The NRP is the platform and the community. Nautilus is the Kubernetes cluster the NRP runs on, and the name you will see in technical documentation and in the cluster tooling itself.',
      },
      {
        title: 'How much does it cost?',
        description:
          'Nothing. We are funded by the U.S. National Science Foundation to provide free access to nonprofit research and education institutions.',
      },
      {
        title: 'Does my project fit here?',
        description:
          'If your work is part of a scientific project or educational use at a U.S. nonprofit institution, yes. That includes community colleges, not just R1 universities.',
      },
      {
        title: "What if I don't know Kubernetes?",
        description:
          'You do not need it. Hosted JupyterHub, Coder, and our inference API require no Kubernetes knowledge. Our tutorials and bi-weekly office hours cover the rest.',
      },
      {
        title: 'Why NRP rather than a commercial cloud?',
        description:
          'It is free to eligible institutions, it is governed by the research community that uses it, and its geographic distribution supports experiments that a single-region cloud cannot.',
      },
      {
        title: 'How can I help?',
        description:
          'Contribute hardware to the cluster, or help by spreading the word. Contributors get priority on their own nodes whenever they want them.',
      },
      {
        title: 'What do I get if I contribute hardware?',
        description:
          'Priority access to your own hardware whenever you need it. When your group is not using it, other NRP users get opportunistic access.',
      },
      {
        title: 'Do I have to administer hardware I contribute?',
        description:
          'No. We install the OS, configure the node, and handle upgrades ourselves; we just need IPMI access. Occasionally we may ask you to reboot a node or swap a drive.',
      },
    ]}
  />

  <!-- Call to action **************** -->
  <CallToAction
    surface="page"
    actions={[
      {
        variant: 'primary',
        text: 'Get started',
        href: '/documentation/userdocs/start/getting-started/',
        icon: 'tabler:arrow-right',
      },
      {
        variant: 'secondary',
        text: 'Contribute hardware',
        href: '/documentation/admindocs/participating/new-contributor-guide/',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="title">Start computing on the NRP</Fragment>

    <Fragment slot="subtitle">
      Bring your research to a platform built and governed by the people who use it.
    </Fragment>
  </CallToAction>
</Layout>
