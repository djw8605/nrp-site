---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro'
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import NextOfficeHours from '~/components/widgets/NextOfficeHours.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import HeroWide from '~/components/widgets/HeroWide.astro';
import SevenNRP from '~/assets/images/7NRP-overlap.png';

const metadata = {
  title: 'National Research Platform (NRP)',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata} id="front-page">
  <!-- Hero Widget ******************* -->
  <!-- image={{ src: '~/assets/images/NRP_globe.jpg', alt: 'NRP Globe image' }} -->
  <!-- bg="<img src='/src/assets/images/NRP_globe.jpg' alt='NRP Background image' class='brightness-50 object-cover object-center w-full h-full' />" -->
  <Hero
    actions={[
      { text: 'Learn more', href: '#features', variant: 'primary' },
    ]}
    
    
    whiteText={true}
    bgImage={{ src: '~/assets/images/NRP_globe.jpg', alt: 'NRP Globe image' }}
  >

    <Fragment slot="title">
      The National Research Platform (NRP): Accelerating Research and Education
    </Fragment>

    <Fragment slot="subtitle">
      The NRP is a community-owned research and education platform connecting
      researchers and educators to foster collaboration, accelerate innovation,
      and share resources. Supported by over 50 institutions, including
      leadership from UC San Diego, the University of Nebraska-Lincoln, and
      the Massachusetts Green High Performance Computing Center, the NRP
      provides access to cutting-edge technologies in AI, high-performance
      computing, data storage, and networking. Open to all nonprofit higher
      education institutions, from community colleges to top research universities,
      the NRP advances learning and scientific breakthroughs with support from the
      U.S. National Science Foundation, Department of Energy, and Department of Defense among others.
    </Fragment>

    <Fragment slot="alert">
      <div id="banner-carousel" class="relative -mt-7 max-w-4xl mx-auto px-4 py-3">
        <!-- Arrows -->
        <button class="banner-arrow prev absolute left-0 top-1/2 -translate-y-1/2 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/40 text-white backdrop-blur-sm transition" aria-label="Previous">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button class="banner-arrow next absolute right-0 top-1/2 -translate-y-1/2 z-10 w-8 h-8 flex items-center justify-center rounded-full bg-white/20 hover:bg-white/40 text-white backdrop-blur-sm transition" aria-label="Next">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>

        <!-- 7NRP - Blue/Indigo with sparkle -->
        <div class="banner-slide" data-slide="0">
          <div class="relative bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600 rounded-xl p-5 shadow-lg ring-2 ring-blue-400/50">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSJ0cmFuc3BhcmVudCIvPgo8Y2lyY2xlIGN4PSIyIiBjeT0iMiIgcj0iMSIgZmlsbD0id2hpdGUiIG9wYWNpdHk9IjAuMSIvPgo8L3N2Zz4=')] opacity-30 rounded-xl"></div>
            <div class="relative flex items-center justify-center gap-4 flex-wrap text-sm">
              <div class="bg-white/20 p-2 rounded-lg backdrop-blur-sm">
                <img src={SevenNRP.src} alt="7NRP logo" class="h-6 w-8 object-contain" />
              </div>
              <div class="text-center">
                <span class="text-white font-bold text-lg block">7NRP Conference 2026</span>
                <span class="text-blue-100 text-sm">May 5-7, 2026 in San Diego - The premier research platform conference</span>
              </div>
              <a href="https://na.eventscloud.com/website/91919/" class="ml-2 px-5 py-2 bg-white text-blue-700 text-sm font-bold rounded-lg hover:bg-blue-50 shadow-md transition transform hover:scale-105">Register Now</a>
            </div>
          </div>
        </div>

        <!-- Training - Purple/Violet -->
        <div class="banner-slide hidden" data-slide="1">
          <div class="relative bg-gradient-to-r from-purple-600 via-violet-600 to-fuchsia-600 rounded-xl p-5 shadow-lg ring-2 ring-purple-400/50">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSJ0cmFuc3BhcmVudCIvPgo8Y2lyY2xlIGN4PSIyIiBjeT0iMiIgcj0iMSIgZmlsbD0id2hpdGUiIG9wYWNpdHk9IjAuMSIvPgo8L3N2Zz4=')] opacity-30 rounded-xl"></div>
            <div class="relative flex items-center justify-center gap-4 flex-wrap text-sm">
              <div class="bg-white/20 p-2 rounded-lg backdrop-blur-sm">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div class="text-center">
                <span class="text-white font-bold text-lg block">NRP Training Recordings</span>
                <span class="text-purple-100 text-sm">Watch February 2026 sessions on Docker, Kubernetes, JupyterHub & more</span>
              </div>
              <a href="/training" class="ml-2 px-5 py-2 bg-white text-purple-700 text-sm font-bold rounded-lg hover:bg-purple-50 shadow-md transition transform hover:scale-105">Watch Now</a>
            </div>
          </div>
        </div>

        <!-- Office Hours - Cyan/Blue with calendar icon -->
        <div class="banner-slide hidden" data-slide="2">
          <div class="relative bg-gradient-to-r from-cyan-600 via-blue-600 to-teal-600 rounded-xl p-5 shadow-lg ring-2 ring-cyan-400/50">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNCIgaGVpZ2h0PSI0IiBmaWxsPSJ0cmFuc3BhcmVudCIvPgo8Y2lyY2xlIGN4PSIyIiBjeT0iMiIgcj0iMSIgZmlsbD0id2hpdGUiIG9wYWNpdHk9IjAuMSIvPgo8L3N2Zz4=')] opacity-30 rounded-xl"></div>
            <div class="relative flex items-center justify-center gap-4 flex-wrap text-sm">
              <div class="bg-white/20 p-2 rounded-lg backdrop-blur-sm">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
              <div class="text-center">
                <span class="text-white font-bold text-lg block">Weekly Office Hours</span>
                <span class="text-cyan-100 text-sm">Every Tuesday at 10am PT - Get help from the NRP team</span>
              </div>
              <a href="https://ucsd.zoom.us/j/96377381436" class="ml-2 px-5 py-2 bg-white text-cyan-700 text-sm font-bold rounded-lg hover:bg-cyan-50 shadow-md transition transform hover:scale-105">Join Meeting</a>
            </div>
          </div>
        </div>

        <!-- LightScope - Emerald/Teal with shield icon -->
        <div class="banner-slide hidden" data-slide="3">
          <div class="relative bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 rounded-xl p-5 shadow-lg ring-2 ring-emerald-400/50">
            <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0IiBoZWlnaHQ9IjQiPgo8cmVjdCB3aWR0aD0iNSIgaGVpZ2h0PSI0IiBmaWxsPSJ0cmFuc3BhcmVudCIvPgo8Y2lyY2xlIGN4PSIyIiBjeT0iMiIgcj0iMSIgZmlsbD0id2hpdGUiIG9wYWNpdHk9IjAuMSIvPgo8L3N2Zz4=')] opacity-30 rounded-xl"></div>
            <div class="relative flex items-center justify-center gap-4 flex-wrap text-sm">
              <div class="bg-white/20 p-2 rounded-lg backdrop-blur-sm">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              </div>
              <div class="text-center">
                <span class="text-white font-bold text-lg block">LightScope - Network Telescopes</span>
                <span class="text-emerald-100 text-sm">NRP hardware contributors: opt-in to forward closed ports to honeypots</span>
              </div>
              <a href="/lightscope" class="ml-2 px-5 py-2 bg-white text-emerald-700 text-sm font-bold rounded-lg hover:bg-emerald-50 shadow-md transition transform hover:scale-105">Learn More</a>
            </div>
          </div>
        </div>

        <!-- Dots -->
        <div class="absolute -bottom-4 left-1/2 transform -translate-x-1/2 flex gap-2 mt-3">
          <button class="banner-dot w-3 h-3 rounded-full bg-white/80 hover:bg-white transition ring-2 ring-white/30" data-slide="0"></button>
          <button class="banner-dot w-3 h-3 rounded-full bg-white/30 hover:bg-white/80 transition ring-2 ring-white/30" data-slide="1"></button>
          <button class="banner-dot w-3 h-3 rounded-full bg-white/30 hover:bg-white/80 transition ring-2 ring-white/30" data-slide="2"></button>
          <button class="banner-dot w-3 h-3 rounded-full bg-white/30 hover:bg-white/80 transition ring-2 ring-white/30" data-slide="3"></button>
        </div>
      </div>
    </Fragment>

  </Hero>

  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="Accelerating Science and Education"
    items={[
      {
        title: 'Artificial Intelligence',
        description:
          'The National Research Platform supports research, education, classes, and workshops, offering modern GPUs, FPGAs, and specialized hardware for advanced AI projects.',
        icon: 'tabler:ai',
        callToAction: {
          text: 'Learn more',
          href: '/documentation/userdocs/ai/llm-managed',
        },
      },
      {
        title: 'Resources for Classroom',
        description:
          'The NRP provides resources for educators to use in their classrooms, including GPUs, CPUs, and storage accessible through convenient interfaces like JupyterHub and Coder.',
        icon: 'tabler:school',
        callToAction: {
          text: 'Learn more',
          href: '/education',
        },
      },
      {
        title: 'Network Experiments',
        description:
          'The NRP nodes are distributed around the world and allow experiments that are impossible on other clusters.',
        icon: 'tabler:network',
        callToAction: {
          text: 'Learn more',
          href: 'https://perfsonar.nrp-nautilus.io/maddash-webui/',
        },
      },
      {
        title: 'Large Data Pools',
        description:
          'Mount your data across the world and use it in your experiments.',
        icon: 'tabler:server-2',
        callToAction: {
          text: 'Learn how to use storage on the NRP',
          href: '/documentation/userdocs/storage/intro',
        },
      },
    ]}
  />
  <!--     items={[
      {
        title: 'Distributed Sites',
        description: 'The NRP is composed of over 70 sites across the USA and world, connected with high speed networks to provide a seamless experience to users.',
        icon: 'tabler:wand'
      },
      {
        title: 'Fault Tolerant',
        description: 'With sites distributed across the world, the NRP is resilient to failures in any one location, ensuring continuous availability and reliability for users.',
        icon: 'tabler:shield-check'
      },

    ]} -->
  
  <!-- Map of NRP Sites -->
  <HeroWide
    title="Distributed Infrastructure"
    subtitle="A global network of research resources — shared compute, data, and services."
    tagline='Global Reach'
    actions={[{ text: 'Learn more', href: '/distributed-infrastructure', variant: 'primary' }]}
    >
    <Fragment slot="image">
      <iframe 
        src="https://dash.nrp-nautilus.io/map"
        title="NRP Sites Map"
        width="100%"
        height="500"
        style="border:0;"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>

  </HeroWide>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`Our blog describes the recent events happening in NRP and all collaborating projects.`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into what NRP can provide to you."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why NRP?',
        description:
          "We are the open community of scientists that together make it possible to collaborate free of limitations. We make cutting edge technologies available to anybody in the scientific community.",
      },
      {
        title: 'How much does it cost?',
        description:
          'We are funded by the U.S. National Science Foundation to provide free access to non-profit research and education institutions.',
      },
      {
        title: 'Does my project fit here?',
        description:
          "As long as your work is related to a scientific project or educational use in the U.S., you can use our infrastructure.",
      },
      {
        title: "What if I'm not fluent with kubernetes?",
        description:
          "We provide hosted JupyterHub, Coder and other high level services that require no knowledge of kubernetes. You can also participate in our tutorials to learn more.",
      },
      {
        title: "How can I help the project?",
        description:
          "We gladly accept donations in the form of hardware that you can join to our cluster. You can also help by spreading the word about the NRP.",
      },
      {
        title: "What will I gain if I join hardware?",
        description:
          "You will get priority in computing on your hardware whenever you'd like. When your hardware is not used by your group, we will provide opportunistic access to it to other NRP users.",
      },
      {
        title: "Do I need to manage the hardware I join to the cluster?",
        description:
          "We will install the OS, configure the node and do upgrades ourselves (we'll need IPMI access to install the OS). We might ask you to reboot the node or swap a hard drive if needed.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Nodes', amount: '400+' },
      { title: 'Locations', amount: '70+' },
      { title: 'Continents', amount: '3' },
      { title: 'Users', amount: '5K+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Join us',
        href: '/documentation/userdocs/start/getting-started/',
        icon: 'tabler:comet',
      },
      {
        variant: 'secondary',
        text: 'Donate hardware',
        href: '/documentation/admindocs/participating/new-contributor-guide/',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="title">
      NRP + Nautilus
    </Fragment>

    <Fragment slot="subtitle">
      Join the cluster today and start your scientific journey with us.
    </Fragment>
  </CallToAction>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const slides = document.querySelectorAll('.banner-slide');
      const dots = document.querySelectorAll('.banner-dot');
      const prevBtn = document.querySelector('.banner-arrow.prev');
      const nextBtn = document.querySelector('.banner-arrow.next');
      let currentSlide = 0;
      let interval: number;

      function showSlide(index: number) {
        slides.forEach((slide, i) => {
          slide.classList.toggle('hidden', i !== index);
        });
        dots.forEach((dot, i) => {
          dot.classList.toggle('bg-white', i === index);
          dot.classList.toggle('bg-white/30', i !== index);
          dot.classList.toggle('bg-white/70', i === index);
        });
        currentSlide = index;
      }

      function nextSlide() {
        showSlide((currentSlide + 1) % slides.length);
      }

      function prevSlide() {
        showSlide((currentSlide - 1 + slides.length) % slides.length);
      }

      // Auto-rotate every 6 seconds
      interval = setInterval(nextSlide, 6000);

      // Dot click handlers
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          clearInterval(interval);
          showSlide(index);
          interval = setInterval(nextSlide, 6000);
        });
      });

      // Arrow click handlers
      prevBtn?.addEventListener('click', () => {
        clearInterval(interval);
        prevSlide();
        interval = setInterval(nextSlide, 6000);
      });

      nextBtn?.addEventListener('click', () => {
        clearInterval(interval);
        nextSlide();
        interval = setInterval(nextSlide, 6000);
      });
    });
  </script>
</Layout>
