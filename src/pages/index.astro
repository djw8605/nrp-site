---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro'
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'National Research Project',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata} id="front-page">
  <!-- Hero Widget ******************* -->
  <!-- image={{ src: '~/assets/images/NRP_globe.jpg', alt: 'NRP Globe image' }} -->
  <!-- bg="<img src='/src/assets/images/NRP_globe.jpg' alt='NRP Background image' class='brightness-50 object-cover object-center w-full h-full' />" -->
  <Hero
    actions={[
      { text: 'Learn more', href: '#features', variant: 'primary' },
    ]}
    
    
    whiteText={true}
    bgImage={{ src: '~/assets/images/NRP_globe.jpg', alt: 'NRP Globe image' }}
  >
    <Fragment slot="title">
      The National Research Platform: Accelerating Research and Education
    </Fragment>

    <Fragment slot="subtitle">
      The NRP is a community-owned research and education platform connecting
      researchers and educators to foster collaboration, accelerate innovation,
      and share resources. Supported by over 50 institutions, including
      leadership from UC San Diego, the University of Nebraska-Lincoln, and
      the Massachusetts Green High Performance Computing Center, the NRP
      provides access to cutting-edge technologies in AI, high-performance
      computing, data storage, and networking. Open to all nonprofit higher
      education institutions, from community colleges to top research universities,
      the NRP advances learning and scientific breakthroughs with support from the
      National Science Foundation, Department of Energy, and Department of Defense among others.
    </Fragment>
  </Hero>
  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Accelerating science"
    title="Multiple science fields"
    items={[
      {
        title: 'Artifical Intelligence',
        description:
          'The research for AI applications.',
        icon: 'tabler:ai',
        callToAction: {
          text: 'Learn more',
          href: '/documentation/userdocs/ai/llm-managed',
        },
      },
      {
        title: 'Machine learning',
        description:
          'Using neural networks for science.',
        icon: 'tabler:artboard',
      },
      {
        title: 'Network experiments',
        description:
          'We have nodes around the world and allow experiments that are impossible on other clusters',
        icon: 'tabler:network',
        callToAction: {
          text: 'Learn more',
          href: 'https://perfsonar.nrp-nautilus.io/maddash-webui/',
        },
      },
      {
        title: 'Large data pools',
        description:
          'Mount your data across the world and use it in your experiments',
        icon: 'tabler:server-2',
        callToAction: {
          text: 'Learn more',
          href: '/viz/storageall',
        },
      },
    ]}
  />

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`Our blog describes the recent events happening in NRP and all collaborating projects.`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into what NRP can provide to you."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why NRP?',
        description:
          "We are the open community of scientists that together make it possible to collaborate free of limitations. We make cutting edge technologies available to anybody in scoentific community.",
      },
      {
        title: 'How much does it cost?',
        description:
          'Free as in beer. We are funded by the National Science Foundation and everybody can use our resources free of charge.',
      },
      {
        title: 'Does my project fit here?',
        description:
          "As long as you work is related to a Scientific project in US, you can use our infrastructure.",
      },
      {
        title: "What if I'm not fluent with kubernetes?",
        description:
          "We provide JupyterHub, Coder and other high level services that require no knowledge of kubernetes. You can also participate in our tutorials to learn more",
      },
      {
        title: "How can I gelp the project?",
        description:
          "We gladly accept donations in the form of hardware that you can join to our cluster. You can also help by spreading the word about our project.",
      },
      {
        title: "What will I gain if I join hardware?",
        description:
          "You will get priority in computing on your hardware whenever you'd like. When it's not used, we will provide shared access to it to other users.",
      },
      {
        title: "Do I need to manage the hardware I join to the cluster?",
        description:
          "We will install the OS, configure the node and do upgrades ourselves (we'll need IPMI access to install the OS). We might ask you to reboot the node or swap a hard drive if needed.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Nodes', amount: '400+' },
      { title: 'Locations', amount: '70+' },
      { title: 'Continents', amount: '3' },
      { title: 'Users', amount: '5K+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Join us',
        href: '/documentation/userdocs/start/getting-started/',
        icon: 'tabler:comet',
      },
      {
        variant: 'secondary',
        text: 'Donate hardware',
        href: '/documentation/admindocs/participating/new-contributor-guide/',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="title">
      NRP + Nautilus
    </Fragment>

    <Fragment slot="subtitle">
      Join the cluster today and start your scientific journey with us.
    </Fragment>
  </CallToAction>
</Layout>
