---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro'
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import NextOfficeHours from '~/components/widgets/NextOfficeHours.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import HeroWide from '~/components/widgets/HeroWide.astro';

const metadata = {
  title: 'National Research Platform (NRP)',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata} id="front-page">
  <!-- Hero Widget ******************* -->
  <!-- image={{ src: '~/assets/images/NRP_globe.jpg', alt: 'NRP Globe image' }} -->
  <!-- bg="<img src='/src/assets/images/NRP_globe.jpg' alt='NRP Background image' class='brightness-50 object-cover object-center w-full h-full' />" -->
  <Hero
    actions={[
      { text: 'Learn more', href: '#features', variant: 'primary' },
    ]}
    
    
    whiteText={true}
    bgImage={{ src: '~/assets/images/NRP_globe.jpg', alt: 'NRP Globe image' }}
  >
    <Fragment slot="alert">
      <span class="block text-2xl font-extrabold text-blue-800 dark:text-blue-200 mb-2">Ready to learn more about the NRP?</span>
      <span class="block text-lg font-bold text-blue-700 dark:text-blue-100 mb-2">Join our <a href="/training" class="text-pink-600 dark:text-pink-300 underline hover:text-pink-800 dark:hover:text-pink-100 font-extrabold">National Research Platform Fall Training</a> between <span class="text-yellow-600 dark:text-yellow-300 font-extrabold">September 2nd to September 30th</span>.</span>
      <span class="block text-lg font-bold mt-2">For more information <a href="/training" class="underline text-blue-700 dark:text-blue-200 hover:text-pink-600 dark:hover:text-pink-400">Click Here</a></span>
    </Fragment>

    <Fragment slot="title">
      The National Research Platform (NRP): Accelerating Research and Education
    </Fragment>

    <Fragment slot="subtitle">
      The NRP is a community-owned research and education platform connecting
      researchers and educators to foster collaboration, accelerate innovation,
      and share resources. Supported by over 50 institutions, including
      leadership from UC San Diego, the University of Nebraska-Lincoln, and
      the Massachusetts Green High Performance Computing Center, the NRP
      provides access to cutting-edge technologies in AI, high-performance
      computing, data storage, and networking. Open to all nonprofit higher
      education institutions, from community colleges to top research universities,
      the NRP advances learning and scientific breakthroughs with support from the
      U.S. National Science Foundation, Department of Energy, and Department of Defense among others.
    </Fragment>

  </Hero>
  <!-- Note Widget ******************* -->

  <Note />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Features"
    title="Accelerating Science and Education"
    items={[
      {
        title: 'Artificial Intelligence',
        description:
          'The National Research Platform supports research, education, classes, and workshops, offering modern GPUs, FPGAs, and specialized hardware for advanced AI projects.',
        icon: 'tabler:ai',
        callToAction: {
          text: 'Learn more',
          href: '/documentation/userdocs/ai/llm-managed',
        },
      },
      {
        title: 'Resources for Classroom',
        description:
          'The NRP provides resources for educators to use in their classrooms, including GPUs, CPUs, and storage accessible through convenient interfaces like JupyterHub and Coder.',
        icon: 'tabler:school',
        callToAction: {
          text: 'Learn more',
          href: '/education',
        },
      },
      {
        title: 'Network Experiments',
        description:
          'The NRP nodes are distributed around the world and allow experiments that are impossible on other clusters.',
        icon: 'tabler:network',
        callToAction: {
          text: 'Learn more',
          href: 'https://perfsonar.nrp-nautilus.io/maddash-webui/',
        },
      },
      {
        title: 'Large Data Pools',
        description:
          'Mount your data across the world and use it in your experiments.',
        icon: 'tabler:server-2',
        callToAction: {
          text: 'Learn how to use storage on the NRP',
          href: '/documentation/userdocs/storage/intro',
        },
      },
    ]}
  />
  <!--     items={[
      {
        title: 'Distributed Sites',
        description: 'The NRP is composed of over 70 sites across the USA and world, connected with high speed networks to provide a seamless experience to users.',
        icon: 'tabler:wand'
      },
      {
        title: 'Fault Tolerant',
        description: 'With sites distributed across the world, the NRP is resilient to failures in any one location, ensuring continuous availability and reliability for users.',
        icon: 'tabler:shield-check'
      },

    ]} -->
  
  <!-- Map of NRP Sites -->
  <HeroWide
    title="Distributed Infrastructure"
    subtitle="A global network of research resources — shared compute, data, and services."
    tagline='Global Reach'
    actions={[{ text: 'Learn more', href: '/distributed-infrastructure', variant: 'primary' }]}
    >
    <Fragment slot="image">
      <iframe 
        src="https://dash.nrp-nautilus.io/map"
        title="NRP Sites Map"
        width="100%"
        height="500"
        style="border:0;"
        loading="lazy"
        allowfullscreen
      ></iframe>
    </Fragment>
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>

  </HeroWide>

  <!-- HighlightedPosts Widget ******* -->

  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`Our blog describes the recent events happening in NRP and all collaborating projects.`}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Frequently Asked Questions"
    subtitle="Dive into the following questions to gain insights into what NRP can provide to you."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: 'Why NRP?',
        description:
          "We are the open community of scientists that together make it possible to collaborate free of limitations. We make cutting edge technologies available to anybody in the scientific community.",
      },
      {
        title: 'How much does it cost?',
        description:
          'We are funded by the U.S. National Science Foundation to provide free access to non-profit research and education institutions.',
      },
      {
        title: 'Does my project fit here?',
        description:
          "As long as your work is related to a scientific project or educational use in the U.S., you can use our infrastructure.",
      },
      {
        title: "What if I'm not fluent with kubernetes?",
        description:
          "We provide hosted JupyterHub, Coder and other high level services that require no knowledge of kubernetes. You can also participate in our tutorials to learn more.",
      },
      {
        title: "How can I help the project?",
        description:
          "We gladly accept donations in the form of hardware that you can join to our cluster. You can also help by spreading the word about the NRP.",
      },
      {
        title: "What will I gain if I join hardware?",
        description:
          "You will get priority in computing on your hardware whenever you'd like. When your hardware is not used by your group, we will provide opportunistic access to it to other NRP users.",
      },
      {
        title: "Do I need to manage the hardware I join to the cluster?",
        description:
          "We will install the OS, configure the node and do upgrades ourselves (we'll need IPMI access to install the OS). We might ask you to reboot the node or swap a hard drive if needed.",
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Nodes', amount: '400+' },
      { title: 'Locations', amount: '70+' },
      { title: 'Continents', amount: '3' },
      { title: 'Users', amount: '5K+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Join us',
        href: '/documentation/userdocs/start/getting-started/',
        icon: 'tabler:comet',
      },
      {
        variant: 'secondary',
        text: 'Donate hardware',
        href: '/documentation/admindocs/participating/new-contributor-guide/',
        icon: 'tabler:server',
      },
    ]}
  >
    <Fragment slot="title">
      NRP + Nautilus
    </Fragment>

    <Fragment slot="subtitle">
      Join the cluster today and start your scientific journey with us.
    </Fragment>
  </CallToAction>
</Layout>
